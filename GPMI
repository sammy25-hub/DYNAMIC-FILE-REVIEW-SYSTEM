    {
      "parameters": {
        "jsCode": "// \u2500\u2500 CHANNEL SEPARATION \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// The code body stored in the data table runs as if it were pasted\n// directly into this node: its $input is the document data and nothing\n// but the document data. Config (splitCode/systemMessage/parserMergeCode/\n// formatReportCode/formatHtmlCode) is read HERE, used HERE, and never\n// crosses into the sandbox \u2014 so no config field can ever be mistaken\n// for document content. Both channels are read from their own source\n// node rather than from Merge Config's flattened item, which is what\n// makes this generic across every docType.\n\n// \u2500\u2500 DEFENSIVE DECODE \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// Code pasted into the data table (via the config-editor form, or the\n// native data-table grid) sometimes arrives HTML-entity-encoded if it\n// was copied from a rich-text source: \"=>\" becomes \"=&gt;\", \"<\" becomes\n// \"&lt;\", etc. That's invalid JS and throws inside new Function() below.\n// splitCode never legitimately needs to contain literal HTML entities,\n// so decoding unconditionally is safe.\nfunction decodeHtmlEntities(str) {\n  if (typeof str !== 'string') return str;\n  return str\n    .replace(/&lt;/g, '<')\n    .replace(/&gt;/g, '>')\n    .replace(/&quot;/g, '\"')\n    .replace(/&#0*39;|&apos;/g, \"'\")\n    .replace(/&amp;/g, '&'); // must run last\n}\n\nconst codeStr  = decodeHtmlEntities($('Get type config').first().json.splitCode);\nconst docItems = $('Extract docType').all().map(it => ({ json: it.json }));\n\n// No split code for this docType \u2192 carry the document data forward\n// unchanged, one item, no chunking. (Not guarded below: a passthrough\n// item is raw document data and is not required to carry a prompt.)\nif (!codeStr || codeStr.trim() === '') return docItems;\n\n// Stand-in for $input exposing ONLY the document data.\nconst shim = {\n  all:   () => docItems,\n  first: () => docItems[0],\n  last:  () => docItems[docItems.length - 1],\n  item:  docItems[0],\n};\n\ntry {\n  const fn = new Function('$input', codeStr);\n  const result = fn(shim);\n\n  const items = Array.isArray(result)\n    ? result\n    : (result && typeof result === 'object' && 'json' in result)\n      ? [result]\n      : null;\n\n  if (!items) {\n    throw new Error('Split code returned neither an array nor a single item, got ' + typeof result);\n  }\n\n  // \u2500\u2500 PROMPT GUARD (dynamic-code path only) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n  // Downstream, AI Review Agent (generic) reads its prompt from\n  // $('Split (generic)').item.json.userMessage. Any item without one\n  // (e.g. a diagnostics-only DEBUG chunk) resolves to an empty prompt\n  // and fails the run with \"No prompt specified\" on that iteration.\n  // Drop those rather than sending them to the model.\n  const usable = items.filter(\n    i => typeof i?.json?.userMessage === 'string' && i.json.userMessage.trim() !== ''\n  );\n\n  if (!usable.length) {\n    throw new Error(\n      'Split code returned ' + items.length + ' item(s) but none carry a non-empty userMessage'\n    );\n  }\n\n  return usable;\n} catch (e) {\n  return [{ json: { ...docItems[0].json, _splitError: e.message } }];\n}"
      },
