'Priority'];\n  const bodyRows = rows.length\n    ? rows\n        .map(\n          (r) => `\n      <tr>\n        <td>${cell(r.issue)}</td>\n        <td>${cell(r.error_in_document)}</td>\n        <td>${cell(r.error_value)}</td>\n        <td>${cell(r.correct_value)}</td>\n        <td>${listCell(r.supporting_documents)}</td>\n        <td>${cell(r.action)}</td>\n        <td>${r.priority ? `<span class=\"tag ${tagClass(r.priority)}\">${esc(r.priority)}</span>` : '\u2014'}</td>\n      </tr>`\n        )\n        .join('')\n    : emptyRow(headers.length);\n  return `\n    <section class=\"section\">\n      <h2>Recommended Actions</h2>\n      <table class=\"data-table\">\n        <thead><tr>${headers.map((h) => `<th>${h}</th>`).join('')}</tr></thead>\n        <tbody>${bodyRows}</tbody>\n      </table>\n    </section>`;\n}\nfunction buildInconclusiveResolutions() {\n  const rows = getArray(data, 'inconclusive_resolutions');\n  if (!rows.length) return ''; // optional section \u2014 omit entirely if empty\n  const headers = ['Document Needed', 'Reason', 'Affected Items', 'Items Count'];\n  const bodyRows = rows\n    .map(\n      (r) => `\n      <tr>\n        <td>${cell(r.document_needed)}</td>\n        <td>${linkifyStandards(r.reason)}</td>\n        <td>${listCell(r.affected_items)}</td>\n        <td>${cell(r.items_count)}</td>\n      </tr>`\n    )\n    .join('');\n  return `\n    <section class=\"section\">\n      <h2>Inconclusive \u2014 Documents Needed</h2>\n      <table class=\"data-table\">\n        <thead><tr>${headers.map((h) => `<th>${h}</th>`).join('')}</tr></thead>\n        <tbody>${bodyRows}</tbody>\n      </table>\n    </section>`;\n}\nfunction buildTranslationConsistency() {\n  const rows = getArray(data, 'translation_consistency_checks');\n  if (!rows.length) return ''; // only populated on Spanish pass \u2014 omit if empty\n  const headers = ['Field', 'English Value', 'Spanish Value', 'Status', 'Reason'];\n  const bodyRows = rows\n    .map(\n      (t) => `\n      <tr>\n        <td>${cell(t.field)}</td>\n        <td>${cell(t.english_value)}</td>\n        <td>${cell(t.spanish_value)}</td>\n        <td>${badge(t.status)}</td>\n        <td>${linkifyStandards(t.reason)}</td>\n      </tr>`\n    )\n    .join('');\n  return `\n    <section class=\"section\">\n      <h2>EN\u2013ES Translation Consistency</h2>\n      <table class=\"data-table\">\n        <thead><tr>${headers.map((h) => `<th>${h}</th>`).join('')}</tr></thead>\n        <tbody>${bodyRows}</tbody>\n      </table>\n    </section>`;\n}\nfunction buildReviewerRemarks() {\n  const remarks = getArray(data, 'reviewer_remarks');\n  if (!remarks.length) return '';\n  return `\n    <section class=\"section\">\n      <h2>Reviewer Remarks</h2>\n      <ul class=\"remarks-list\">\n        ${remarks.map((r) => `<li>${esc(r)}</li>`).join('')}\n      </ul>\n    </section>`;\n}\n// ---------------------------------------------------------------------------\n// CSS\n// ---------------------------------------------------------------------------\nconst CSS = `\n  * { box-sizing: border-box; }\n  body {\n    font-family: Arial, Helvetica, sans-serif;\n    color: #1f2937;\n    margin: 0;\n    padding: 0;\n    background: #ffffff;\n    font-size: 13px;\n    line-height: 1.45;\n  }\n  html, body {\n    width: 180mm; margin: 0 auto; padding: 0;\n  }\n  .page-wrap { width: 100%; max-width: 180mm; margin: 0 auto; padding: 0 0 40px 0; }\n  .report-header { background: #16233f; color: #ffffff; text-align: center; padding: 28px 20px 24px; }\n  .report-header h1 { margin: 0 0 6px 0; font-size: 26px; letter-spacing: 0.5px; }\n  .report-subtitle { font-size: 14px; color: #c9d3e6; }\n  .note-box {\n    background: #fff8e1; border: 1px solid #f0d98c; color: #6b5410;\n    margin: 20px 24px 0; padding: 14px 18px; border-radius: 4px; font-size: 12.5px;\n  }\n  .section { margin: 24px 10px 0; }\n  .section h2 {\n    font-size: 17px; margin: 0 0 10px 0; padding-bottom: 6px;\n    border-bottom: 2px solid #16233f; color: #16233f;\n  }\n  .detail-grid { border: 1px solid #e2e5ea; border-radius: 4px; overflow: hidden; }\n  .detail-row { display: flex; border-bottom: 1px solid #e2e5ea; }\n  .detail-row:last-child { border-bottom: none; }\n  .detail-cell { flex: 1; padding: 10px 16px; border-right: 1px solid #e2e5ea; }\n  .detail-cell:last-child { border-right: none; }\n  .detail-label { font-size: 10.5px; font-weight: bold; color: #4b5563; letter-spacing: 0.4px; margin-bottom: 3px; }\n  .detail-value { font-size: 13px; color: #111827; }\n  table.data-table {\n    width: 100%; table-layout: fixed; border-collapse: collapse; border: 1px solid #e2e5ea;\n  }\n  table.data-table th {\n    background: #16233f; color: #ffffff; text-align: left; padding: 9px 12px;\n    font-size: 11.5px; letter-spacing: 0.3px;\n    overflow-wrap: break-word; word-break: break-word;\n  }\n  table.data-table td {\n    padding: 10px 12px; border-top: 1px solid #e9ecf1; vertical-align: top; font-size: 12.5px;\n    overflow-wrap: break-word; word-break: break-word; white-space: normal;\n  }\n  table.data-table tr:nth-child(even) td { background: #fafbfc; }\n  .empty-row { text-align: center; font-style: italic; color: #9aa1ab; padding: 16px !important; }\n  /* Check cards \u2014 replaces the old 7-column table for Test Data / Status /\n     Reference Doc / Reference File Data / Public Source / Public Data / Reason.\n     Same underlying fields, rendered as a stacked card per check instead of a\n     table row, matching the reference layout. */\n  .check-card-list { display: flex; flex-direction: column; gap: 8px; margin-top: 4px; }\n  .check-card {\n    border-radius: 6px; padding: 8px 12px; background: #fafbfc;\n    border-left: 4px solid #9aa1ab; font-size: 11px;\n  }\n  .check-card.cc-green  { border-left-color: #2fa360; }\n  .check-card.cc-blue   { border-left-color: #2c7be5; }\n  .check-card.cc-red    { border-left-color: #d9534f; background: #fdecea; }\n  .check-card.cc-amber  { border-left-color: #e0a638; background: #fff8e6; }\n  .check-card.cc-neutral{ border-left-color: #9aa1ab; }\n  .check-card-top { display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; margin-bottom: 4px; }\n  .check-idlabel { font-size: 12px; color: #16233f; }\n  .field-row { font-size: 10.5px; color: #374151; margin: 3px 0; overflow-wrap: anywhere; word-break: break-word; }\n  .field-label { font-weight: bold; color: #16233f; }\n  .field-value-strong { font-weight: bold; color: #111827; }\n  .src-link { color: #2c7be5; text-decoration: underline; }\n  .check-reason { font-size: 10px; color: #6b7280; margin-top: 4px; }\n  .empty-card { font-style: italic; color: #9aa1ab; text-align: center; }\n  /* Entry cards \u2014 one per literature entry, colored left border reflects the worst\n     status among that entry's own checks (green = all compliant/assumed,\n     amber = inconclusive present, red = non-compliant present). */\n  .entry-section { margin-top: 24px; }\n  .entry-card {\n    border: 1px solid #e2e5ea; border-left: 5px solid #2fa360; border-radius: 8px;\n    padding: 16px 18px; background: #ffffff;\n  }\n  .entry-card.entry-nc  { border-left-color: #d9534f; }\n  .entry-card.entry-inc { border-left-color: #e0a638; }\n  .entry-title {\n    font-size: 16px; font-weight: bold; color: #16233f; margin: 0 0 10px;\n    padding-bottom: 8px; border-bottom: 1px solid #e2e5ea;\n  }\n  .entry-meta-block { font-size: 11.5px; color: #374151; margin-bottom: 10px; }\n  .entry-meta-block div { margin-bottom: 3px; overflow-wrap: break-word; }\n  .meta-label { font-weight: bold; color: #16233f; }\n  .cell-list { margin: 0; padding-left: 16px; }\n  .badge {\n    display: inline-block; padding: 3px 10px; border-radius: 3px; font-weight: bold;\n    font-size: 11px; color: #ffffff; letter-spacing: 0.3px; white-space: nowrap;\n  }\n  .badge-green  { background: #2fa360; }\n  .badge-blue   { background: #2c7be5; }\n  .badge-red    { background: #d9534f; }\n  .badge-amber  { background: #e0a638; }\n  .badge-neutral{ background: #9aa1ab; }\n  .overall-banner {\n    margin-top: 14px; padding: 14px; text-align: center; color: #ffffff;\n    font-weight: bold; font-size: 14px; border-radius: 4px; letter-spacing: 0.3px;\n  }\n  .overall-green { background: #2fa360; }\n  .overall-red   { background: #d9534f; }\n  .overall-amber { background: #e0a638; }\n  .tag-row { margin-top: 6px; margin-bottom: 6px; }\n  .tag {\n    display: inline-block; border: 1px solid #c7cdd6; color: #4b5563; background: #f5f6f8;\n    font-size: 10px; padding: 2px 7px; border-radius: 3px; margin: 2px 4px 2px 0;\n  }\n  .tag-major { border-color: #e0a638; color: #92600f; background: #fdf3e0; }\n  .tag-minor { border-color: #c7cdd6; color: #4b5563; background: #f5f6f8; }\n  .tag-neutral { border-color: #c7cdd6; color: #4b5563; background: #f5f6f8; }\n  .remarks-list { margin: 0; padding-left: 20px; }\n  .remarks-list li { margin-bottom: 6px; }\n  /* Dynamically-discovered images (e.g. chemical structure diagrams) \u2014 rendered\n     wherever they were found: on the entry/check card that owns them, or in the\n     global \"Supporting Images\" section for anything else in the document. */\n  .image-card-list {\n    display: flex; flex-wrap: wrap; gap: 12px; margin: 10px 0;\n  }\n  .image-card-list-inline { margin: 8px 0 10px; }\n  .image-card {\n    border: 1px solid #e2e5ea; border-radius: 6px; padding: 8px; background: #ffffff;\n    text-align: center; width: 220px;\n  }\n  .image-card-img {\n    max-width: 100%; max-height: 260px; object-fit: contain; display: block; margin: 0 auto 6px;\n  }\n  .image-card-label {\n    font-size: 10.5px; color: #4b5563; word-break: break-word;\n  }\n  @media print {\n    /* Do NOT apply page-break-inside:avoid to .section/.entry-card/.report-header \u2014\n       an entry section (title + meta + up to 6 check-cards) is routinely taller than\n       a single printed page. Forcing \"never break this block\" on something taller\n       than one page is what caused entries to be dropped/clipped unpredictably by\n       the PDF renderer. Only protect elements small enough to always fit on one page. */\n    .check-card { page-break-inside: avoid; break-inside: avoid; }\n    .detail-row { page-break-inside: avoid; break-inside: avoid; }\n    table.data-table tr { page-break-inside: avoid; break-inside: avoid; }\n    .image-card { page-break-inside: avoid; break-inside: avoid; }\n  }\n`;\n// ---------------------------------------------------------------------------\n// ASSEMBLE\n// ---------------------------------------------------------------------------\nconst bodyHtml = `\n  <div class=\"page-wrap\">\n    ${buildHeader()}\n    ${buildNote()}\n    ${buildProductDetails()}\n    ${buildImagesSection(globalImages, 'Supporting Images & Chemical Structures')}\n    ${buildDocumentsAnalyzed()}\n    ${buildSummaryIndex()}\n    ${buildGenericCheckTable('Document Identity Checks', getArray(data, 'document_id_checks'))}\n    ${buildGenericCheckTable('Table Structure Checks', getArray(data, 'table_structure_checks'))}\n    ${buildEntryChecks()}\n    ${buildGenericCheckTable('Coverage Checks', getArray(data, 'coverage_checks'))}\n    ${buildGenericCheckTable('Bibliography Checks', getArray(data, 'bibliography_checks'))}\n    ${buildGenericCheckTable('Formatting Checks', getArray(data, 'formatting_checks'))}\n    ${buildArithmeticChecks()}\n    ${buildCrossDocumentMismatches()}\n    ${buildRecommendedActions()}\n    ${buildInconclusiveResolutions()}\n    ${buildTranslationConsistency()}\n    ${buildReviewerRemarks()}\n  </div>`;\nconst pageTitle = reportTitle;\nconst html = `<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\" />\n<title>${esc(pageTitle)}</title>\n<style>${CSS}</style>\n</head>\n<body>\n${bodyHtml}\n</body>\n</html>`;\n// ---------------------------------------------------------------------------\n// OUTPUT\n// ---------------------------------------------------------------------------\nconst apiNameForFile = get(data, 'product_details.api_name', 'report').toString().replace(/[^a-z0-9]+/gi, '_');\nconst docTypeForFile = (get(data, 'main_file_name', '') || get(data, 'report_title', '') || 'Report').toString().replace(/[^a-z0-9]+/gi, '_');\n// FIX: reuse the same IST `dateOnly` already computed for the report body's\n// EXECUTION DATE/TIME field, instead of a separate new Date() call in UTC \u2014\n// previously these two could disagree by one calendar day near IST midnight.\nconst fileName = `GPMI_${docTypeForFile}_${apiNameForFile}_${dateOnly}.pdf`;\nreturn [\n  {\n    json: {\n      ...data,          // preserve every original field for any downstream node\n      html,\n      formatted_report: html,   // <-- required: \"Prepare PDF\" / \"Generate PDF1\" read this key\n      pdf_filename: fileName,\n      product_code: productCode,        // surfaced for any downstream node (e.g. Zoho upload naming)\n      images_found_count: discoveredImages.length, // useful for debugging upstream image attachment\n    },\n  },\n];"
