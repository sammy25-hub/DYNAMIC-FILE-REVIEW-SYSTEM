      "parameters": {
        "jsCode": "/**\n * =====================================================================================\n *  Format HTML (Literature Review)2 \u2014 n8n Code Node\n *  Matches the ACTUAL schema produced by Parse AI Response (Literature Review)2:\n *  report_title, product_details{api_name,generic_name,execution_date_time},\n *  api_name_secondary, dosage_form, strength, product_type, is_combination,\n *  documents_analyzed[], summary_index[], document_id_checks[], table_structure_checks[],\n *  entry_checks[].checks[], coverage_checks[], bibliography_checks[], formatting_checks[],\n *  arithmetic_checks[], cross_document_mismatches[], recommended_actions[],\n *  inconclusive_resolutions[], translation_consistency_checks[], summary{}, reviewer_remarks[]\n *\n *  This same JSON schema is shared by EVERY report this node formats (every\n *  product, every pass, every language) \u2014 only the field VALUES differ from\n *  run to run, never the field NAMES/shape. Because every builder below reads\n *  fields by name via get()/getArray() (with safe fallbacks for anything\n *  missing/empty/null) rather than assuming any particular product's content,\n *  this single Code node is meant to be used as-is for every file/report that\n *  comes out of Parse AI Response (Literature Review)2 \u2014 no per-product or\n *  per-pass branching needed. Swap the upstream data; this node does not\n *  change.\n *\n *  Outputs BOTH `html` and `formatted_report` (identical), since the shared\n *  \"Prepare PDF\" convergence node / \"Generate PDF1\" HTTP node reads\n *  $('Prepare PDF').first().json.formatted_report.\n *\n *  PRODUCT CODE (NEW)\n *  ---------------------------------------------------------------------------\n *  The Parse AI Response step does not carry the main document's product\n *  code, so this node reaches back to the \"Extract and Prepare\" node (the\n *  node that first parsed/extracted the main dossier document) and pulls the\n *  product code from there. Several common field-name shapes are checked, in\n *  order, so this keeps working even if the exact key used by \"Extract and\n *  Prepare\" varies slightly between pipelines:\n *    product_code, productCode, product_details.product_code,\n *    productDetails.productCode, main_document.product_code\n *  If \"Extract and Prepare\" is unreachable for any reason (renamed, not run\n *  in this branch, etc.) or none of the above keys are present, this falls\n *  back to any product_code already present on the current item's own data,\n *  then finally to an em dash \u2014 it never throws and never blocks report\n *  generation.\n *\n *  DYNAMIC IMAGE SUPPORT\n *  ---------------------------------------------------------------------------\n *  The AI/parsing step upstream may or may not attach images (e.g. a chemical\n *  structure diagram) to the payload, and it may attach them under any field\n *  name, at any depth (top-level, inside product_details, inside a specific\n *  entry_checks[] item, inside a check object, etc.), and in any common shape:\n *    - a data URI string:            \"data:image/png;base64,iVBORw0KG...\"\n *    - a raw base64 string:          \"iVBORw0KG...\" (magic-number sniffed)\n *    - an image URL:                 \"https://.../structure.png\"\n *    - an n8n-style binary object:   { data: \"<base64>\", mimeType, fileName }\n *    - a binary attachment on the input item itself ($input.first().binary)\n *  This code node scans the ENTIRE payload (and the item's binary data) for\n *  anything that looks like an image, and renders every image it finds into\n *  the report \u2014 no matter which field it arrived in. Images found inside a\n *  specific literature entry are shown on that entry's own card; every other\n *  image (product-level chemical structure, document-level figures, etc.) is\n *  shown in a dedicated \"Supporting Images\" section. Nothing needs to be\n *  hard-coded per field name for this to keep working as the schema evolves.\n * =====================================================================================\n */\n// Defensive: every report run comes through this same node, so a missing/odd\n// input item on any one file should degrade gracefully (empty report sections)\n// rather than crash the whole workflow run.\nconst __firstItem = $input.first() || {};\nconst data = __firstItem.json || {};\n\n// ---------------------------------------------------------------------------\n// EXTRACT AND PREPARE NODE LOOKUP (for Product Code)\n// ---------------------------------------------------------------------------\n// Wrapped in try/catch because $('Node Name') throws if the node doesn't\n// exist / wasn't executed on this branch \u2014 we never want that to break\n// report generation, so an empty object is used as a safe fallback.\nfunction getUpstreamNodeJson(nodeName) {\n  try {\n    const item = $(nodeName).first();\n    return (item && item.json) || {};\n  } catch (e) {\n    return {};\n  }\n}\nconst extractAndPrepareData = getUpstreamNodeJson('Extract and Prepare');\n\n// ---------------------------------------------------------------------------\n// HELPERS\n// ---------------------------------------------------------------------------\nfunction esc(v) {\n  if (v === null || v === undefined || v === '') return '';\n  return String(v)\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;')\n    .replace(/\"/g, '&quot;');\n}\nfunction get(obj, path, fallback) {\n  try {\n    const val = path.split('.').reduce((o, k) => (o === null || o === undefined ? undefined : o[k]), obj);\n    if (val === undefined || val === null || val === '') return fallback;\n    return val;\n  } catch (e) {\n    return fallback;\n  }\n}\nfunction getArray(obj, path) {\n  const val = get(obj, path, []);\n  return Array.isArray(val) ? val : [];\n}\nfunction cell(v) {\n  if (v === null || v === undefined || v === '') return '\u2014';\n  if (Array.isArray(v)) return v.length ? v.map(esc).join('<br>') : '\u2014';\n  return esc(v);\n}\n// FIX: public_source/public_data are free-text fields that only SOMETIMES contain\n// a real URL (e.g. \"PubChem\" has none; \"Molecular Formula: ... \u2014 https://pubchem...\"\n// or a trained_data_note fallback like \"ICH Q1A(R2): ... \u2014 MATCHES. Source: https://...\"\n// has one). The previous code unconditionally wrapped the ENTIRE public_source string\n// in <a href=\"{public_source}\">, which for a bare label like \"PubChem\" produced a\n// broken href (not a URL at all), and for a full sentence produced a mangled href\n// with the whole sentence stuffed into the href attribute \u2014 in both cases the text\n// LOOKED like a link (blue, underlined) but did not go anywhere real. Meanwhile\n// public_data, which actually follows a \"value \u2014 URL\" format, was rendered as\n// plain non-clickable text. This extracts the first real URL substring (if any)\n// and turns ONLY that substring into a working link, leaving the rest of the\n// sentence as plain text; if no URL is present, the whole thing renders as plain\n// text instead of a fake, non-functional link.\nconst URL_RE = /https?:\\/\\/[^\\s<>\"')]+/;\nfunction linkifyIfUrl(v) {\n  if (v === null || v === undefined || v === '') return '\u2014';\n  const str = String(v);\n  const m = str.match(URL_RE);\n  if (!m) return esc(str);\n  const url = m[0];\n  const before = str.slice(0, m.index);\n  const after = str.slice(m.index + url.length);\n  return `${esc(before)}<a href=\"${esc(url)}\" target=\"_blank\" rel=\"noopener\" class=\"src-link\">${esc(url)}</a>${esc(after)}`;\n}\n// FIX: the AI Agent is instructed to cite specific regulatory standards (ICH Q1A(R2),\n// ICH Q1E, 21 CFR 211.166) by name inside free-text \"reason\"/\"working\" sentences\n// (e.g. \"...matches ICH Q1A(R2) Zone IVa. COMPLIANT_CONFIRMED...\"), but it does not\n// reliably also populate a separate trained_data_note/public_source field with the\n// matching source URL \u2014 so linkifyIfUrl above (which only looks for a literal URL\n// already present in the text) has nothing to find, and the standard name renders\n// as plain, non-clickable text even though a citation IS being made. Rather than\n// depend on the model to remember to attach a URL every time, this deterministically\n// recognizes a small, explicitly-whitelisted set of standard names anywhere they\n// appear in reason/working text and wraps ONLY that matched name in a real link to\n// its known, fixed source URL \u2014 never a guessed or model-supplied one. Standards\n// without a stable free public deep link (WHO TRS 953, BP 2022, USP-NF/USP) are\n// deliberately NOT in this list and stay as plain text, per the same anti-hallucination\n// principle used elsewhere: never fabricate a link for a source that doesn't have one.\nconst KNOWN_STANDARD_LINKS = [\n  { re: /Q1A\\s*ICH\\s*standard\\s*\\(R2\\)/gi, url: 'https://database.ich.org/sites/default/files/Q1A%28R2%29%20Guideline.pdf' },\n  { re: /ICH\\s*Q1A\\s*\\(R2\\)/gi, url: 'https://database.ich.org/sites/default/files/Q1A%28R2%29%20Guideline.pdf' },\n  { re: /ICH\\s*Q1E\\b/gi, url: 'https://database.ich.org/sites/default/files/Q1E%20Guideline.pdf' },\n  { re: /21\\s*CFR\\s*211\\.166/gi, url: 'https://www.ecfr.gov/current/title-21/chapter-I/subchapter-C/part-211/subpart-I/section-211.166' },\n];\nfunction linkifyStandards(v) {\n  if (v === null || v === undefined || v === '') return '\u2014';\n  let remaining = String(v);\n  let out = '';\n  while (remaining.length) {\n    let earliest = null;\n    for (const p of KNOWN_STANDARD_LINKS) {\n      p.re.lastIndex = 0;\n      const m = p.re.exec(remaining);\n      if (m && (earliest === null || m.index < earliest.index)) {\n        earliest = { index: m.index, text: m[0], url: p.url };\n      }\n    }\n    if (!earliest) {\n      out += esc(remaining);\n      break;\n    }\n    out += esc(remaining.slice(0, earliest.index));\n    out += `<a href=\"${esc(earliest.url)}\" target=\"_blank\" rel=\"noopener\" class=\"src-link\">${esc(earliest.text)}</a>`;\n    remaining = remaining.slice(earliest.index + earliest.text.length);\n  }\n  return out;\n}\nfunction listCell(v) {\n  if (v === null || v === undefined || v === '') return '\u2014';\n  const arr = Array.isArray(v) ? v : [v];\n  if (!arr.length) return '\u2014';\n  if (arr.length === 1) return esc(arr[0]);\n  return `<ul class=\"cell-list\">${arr.map((x) => `<li>${esc(x)}</li>`).join('')}</ul>`;\n}\n// Formats reference_file_data which may be:\n//   - a plain string\n//   - an array of strings\n//   - an object whose keys are source names (e.g. SMPC, PIL) and values are\n//     the extracted text for that source \u2014 rendered as \"KEY: 'value'; KEY: 'value'\"\nfunction formatRefFileData(v) {\n  if (v === null || v === undefined || v === '') return '\u2014';\n  if (typeof v === 'string') return esc(v);\n  if (Array.isArray(v)) {\n    if (!v.length) return '\u2014';\n    // Array items may themselves be objects or strings\n    const parts = v.map((item) => {\n      if (item === null || item === undefined) return '';\n      if (typeof item === 'string') return esc(item);\n      if (typeof item === 'object') {\n        return Object.entries(item)\n          .map(([k, val]) => `${esc(k)}: '${esc(String(val))}'`)\n          .join('; ');\n      }\n      return esc(String(item));\n    }).filter(Boolean);\n    if (parts.length === 1) return parts[0];\n    return `<ul class=\"cell-list\">${parts.map((p) => `<li>${p}</li>`).join('')}</ul>`;\n  }\n  if (typeof v === 'object') {\n    const entries = Object.entries(v);\n    if (!entries.length) return '\u2014';\n    return esc(\n      entries.map(([k, val]) => `${k}: '${String(val)}'`).join('; ')\n    );\n  }\n  return esc(String(v));\n}\nfunction statusClass(status) {\n  if (!status) return 'badge-neutral';\n  const s = String(status).toUpperCase();\n  if (['COMPLIANT', 'PASS', 'YES', 'OK', 'MATCH'].includes(s)) return 'badge-green';\n  if (['COMPLIANT_ASSUMED', 'ASSUMED'].includes(s)) return 'badge-blue';\n  if (['NON_COMPLIANT', 'NOT FOUND', 'NON-COMPLIANT', 'FAIL', 'NO', 'MISSING'].includes(s)) return 'badge-red';\n  if (['INCONCLUSIVE', 'SKIPPED_CONDITIONAL', 'PARTIAL', 'REVIEW', 'PENDING', 'N/A'].includes(s)) return 'badge-amber';\n  return 'badge-neutral';\n}\nfunction badge(status) {\n  if (status === null || status === undefined || status === '') return '\u2014';\n  return `<span class=\"badge ${statusClass(status)}\">${esc(String(status).replace(/_/g, ' '))}</span>`;\n}\nfunction tagClass(tag) {\n  const t = String(tag).split(':')[0].trim().toUpperCase();\n  if (t === 'MAJOR' || t === 'CRITICAL') return 'tag-major';\n  if (t === 'MINOR') return 'tag-minor';\n  return 'tag-neutral';\n}\nfunction tagRow(tags) {\n  if (!tags || !tags.length) return '';\n  return `<div class=\"tag-row\">${tags.map((t) => `<span class=\"tag ${tagClass(t)}\">${esc(t)}</span>`).join('')}</div>`;\n}\nfunction overallClass(status) {\n  const s = String(status || '').toUpperCase();\n  if (s === 'COMPLIANT' || s === 'PASS') return 'overall-green';\n  if (s.includes('NON_COMPLIANT') || s === 'FAIL') return 'overall-red';\n  return 'overall-amber';\n}\nfunction emptyRow(colSpan, message) {\n  return `<tr><td class=\"empty-row\" colspan=\"${colSpan}\">${esc(message || 'None recorded.')}</td></tr>`;\n}\nfunction boolLabel(v) {\n  return v === true ? 'Yes' : v === false ? 'No' : '\u2014';\n}\n// The report's \"generated at\" timestamp must reflect when THIS report was produced,\n// not any date supplied by the AI agent (which reflects document/model data, not\n// generation time). Captured fresh every time this node runs.\n// \u2500\u2500 Shared IST timestamp helper \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// Use this everywhere instead of manual +5.5h offsets or plain UTC,\n// so every report in the pipeline shows the same timezone/format.\nfunction getISTTimestamp(d = new Date()) {\n  const parts = new Intl.DateTimeFormat('en-CA', {\n    timeZone: 'Asia/Kolkata',\n    year: 'numeric', month: '2-digit', day: '2-digit',\n    hour: 'numeric', minute: '2-digit', hour12: true,\n  }).formatToParts(d).reduce((acc, p) => { acc[p.type] = p.value; return acc; }, {});\n  const dateStr = `${parts.year}-${parts.month}-${parts.day}`;\n  const ampm = parts.dayPeriod.replace(/\\./g, '').toUpperCase(); // 'A.M.' -> 'AM'\n  const timeStr = `${parts.hour}:${parts.minute} ${ampm}`;\n  return { display: `${dateStr} ${timeStr} IST`, dateOnly: dateStr };\n}\n\nconst { display: reportGeneratedAt, dateOnly } = getISTTimestamp();\n\n// ---------------------------------------------------------------------------\n// PRODUCT CODE RESOLUTION\n// ---------------------------------------------------------------------------\n// IMPORTANT: the product code is NOT a JSON field anywhere in this pipeline \u2014\n// it only ever exists as a numeric prefix on the ORIGINAL uploaded filename,\n// e.g. \"2192-Literature Review-12774.pdf\" \u2192 product code \"2192\". So instead\n// of looking for a product_code KEY (which doesn't exist upstream), this\n// scans every place a filename could have survived to this point and pulls\n// the leading number off of it.\n//\n// Priority order for where the filename might still be found:\n//   1. Explicit product_code-ish JSON fields, in case a future pipeline\n//      change starts emitting one directly \u2014 cheap to keep as a first check.\n//   2. Binary attachment filenames on the \"Extract and Prepare\" node's own\n//      output item (most reliable \u2014 that's the node that first touched the\n//      raw uploaded file).\n//   3. Binary attachment filename on the CURRENT item (in case it was\n//      carried forward through binary data rather than JSON).\n//   4. Common filename-shaped JSON fields on \"Extract and Prepare\" and on\n//      the current item's data (filename, fileName, document_name, etc.),\n//      including one level of nesting under product_details/file/document.\nfunction extractLeadingCode(name) {\n  if (!name || typeof name !== 'string') return '';\n  // Strip any path and the file extension first.\n  const base = name.split(/[\\\\/]/).pop().replace(/\\.[a-z0-9]{2,5}$/i, '');\n  // Leading run of 3+ digits followed by a separator, e.g. \"2192-Literature...\"\n  const m = base.match(/^(\\d{3,})[\\s_-]/);\n  return m ? m[1] : '';\n}\nfunction collectCandidateFilenames() {\n  const names = [];\n  const push = (v) => { if (typeof v === 'string' && v) names.push(v); };\n\n  // Binary filenames (most reliable source \u2014 the raw upload's own name)\n  try {\n    const epItem = $('Extract and Prepare').first();\n    if (epItem && epItem.binary) {\n      Object.values(epItem.binary).forEach((b) => push(b && (b.fileName || b.filename)));\n    }\n  } catch (e) { /* node not reachable on this branch \u2014 ignore */ }\n  if (__firstItem && __firstItem.binary) {\n    Object.values(__firstItem.binary).forEach((b) => push(b && (b.fileName || b.filename)));\n  }\n\n  // Ground-truth primary-document filename, if present. \"documents_analyzed\" is\n  // populated deterministically from the real document manifest (see the\n  // \"Documents Analyzed\" table's own isPrimary logic below, which this mirrors) \u2014\n  // it's far more reliable than guessing from a generic top-level \"name\" field,\n  // and unlike the binary lookup above it survives pipelines where the merge step\n  // (not \"Extract and Prepare\") is the last node to see the real filename.\n  [extractAndPrepareData, data].forEach((obj) => {\n    const docs = getArray(obj, 'documents_analyzed');\n    const primary = docs.find((d, idx) => String(d.role || '').toUpperCase() === 'PRIMARY' || Number(d.doc_id) === 1 || idx === 0);\n    if (primary) { push(primary.filename); push(primary.document_name); }\n  });\n\n  // Common filename-shaped JSON fields\n  const nameFields = ['filename', 'fileName', 'file_name', 'original_filename', 'originalFileName', 'document_name', 'documentName', 'name', 'main_file_name'];\n  [extractAndPrepareData, data].forEach((obj) => {\n    nameFields.forEach((f) => push(get(obj, f, '')));\n    ['product_details', 'file', 'document', 'main_document'].forEach((container) => {\n      const c = get(obj, container, null);\n      if (c && typeof c === 'object') nameFields.forEach((f) => push(c[f]));\n    });\n  });\n\n  return names;\n}\nfunction resolveProductCode() {\n  // 1. Explicit product_code-ish fields, if a pipeline ever starts emitting one.\n  const explicitCandidates = [\n    get(extractAndPrepareData, 'product_code', ''),\n    get(extractAndPrepareData, 'productCode', ''),\n    get(data, 'product_code', ''),\n  ];\n  const explicit = explicitCandidates.find((c) => c !== '' && c !== undefined && c !== null);\n  if (explicit) return explicit;\n\n  // 2. Derive it from whichever original filename survived to this point.\n  const filenames = collectCandidateFilenames();\n  for (const fn of filenames) {\n    const code = extractLeadingCode(fn);\n    if (code) return code;\n  }\n  return '';\n}\nconst productCode = resolveProductCode();\n\n// ---------------------------------------------------------------------------\n// DYNAMIC REPORT TITLE (Product Name + Primary/Test Document Name)\n// ---------------------------------------------------------------------------\n// The visible report title must read \"<Product Name> \u2014 <Primary/Test Document\n// Name>\" (e.g. \"Levetiracetam \u2014 Literature Review\") for every product and\n// every document type this node ever formats, instead of the AI-authored\n// report_title string, which varies in wording from pass to pass (e.g.\n// \"GPMI \u2014 Literature Review Review \u2014 Pass: E\"). Both pieces are sourced from\n// \"Extract and Prepare\" \u2014 the same node product code is read from above \u2014 so\n// the title stays consistent regardless of how the AI agent phrases things.\nfunction extractDocumentLabel(name) {\n  if (!name || typeof name !== 'string') return '';\n  const base = name.split(/[\\\\/]/).pop().replace(/\\.[a-z0-9]{2,5}$/i, '');\n  // \"2591-Literature Review-12558\" -> \"Literature Review\" (strip the leading\n  // and trailing numeric codes around the separators, keep the human-readable\n  // middle part \u2014 this is the same filename shape product code is parsed from).\n  const withBothCodes = base.match(/^\\d{3,}[\\s_-]+(.+?)[\\s_-]+\\d+$/);\n  if (withBothCodes) return withBothCodes[1].trim();\n  // No trailing numeric suffix present \u2014 just strip a leading numeric code.\n  const withLeadingCode = base.match(/^\\d{3,}[\\s_-]+(.+)$/);\n  return (withLeadingCode ? withLeadingCode[1] : base).trim();\n}\n// FIX: excipient/raw-material COA passes (document_type e.g. \"COA_PM\") often leave\n// product_details.api_name/generic_name blank \u2014 there's no \"API\" on a Sodium\n// Chloride USP excipient COA \u2014 and \"Extract and Prepare\" may carry no usable\n// product name either, so every candidate below resolved empty and the title\n// silently fell back to the raw document_type code (e.g. just \"COA_PM\"). Every\n// one of these documents still states its product name INSIDE the report body\n// though: check_point values are written as \"<Product Name>: <Field>\" (e.g.\n// \"Sodium Chloride USP: Product Name\"), and the AI Agent fills a literal\n// test_data value for the check whose check_point ends in \"Product Name\". This\n// mines that instead of leaving the title as just the document type code.\nfunction getAllChecks(obj) {\n  const out = [];\n  ['document_id_checks', 'table_structure_checks', 'coverage_checks', 'bibliography_checks', 'formatting_checks'].forEach((k) => {\n    getArray(obj, k).forEach((c) => out.push(c));\n  });\n  getArray(obj, 'entry_checks').forEach((entry) => {\n    (Array.isArray(entry.checks) ? entry.checks : []).forEach((c) => out.push(c));\n  });\n  return out;\n}\nfunction findProductNameFromChecks(obj) {\n  const checks = getAllChecks(obj);\n  // 1. A check explicitly labeled \"... Product Name\" carries the real value in test_data.\n  const explicit = checks.find((c) => /product name/i.test(String(c.check_point || '')) && c.test_data);\n  if (explicit) return String(explicit.test_data).trim();\n  // 2. Every check_point in a document/product-scoped report shares the same\n  //    \"<Product Name>: <Field>\" prefix \u2014 reuse it if present and colon-separated.\n  const withPrefix = checks.find((c) => /^[^:]{2,60}:\\s*\\S/.test(String(c.check_point || '')));\n  if (withPrefix) return String(withPrefix.check_point).split(':')[0].trim();\n  return '';\n}\nfunction resolveProductName() {\n  const candidates = [\n    get(extractAndPrepareData, 'product_name', ''),\n    get(extractAndPrepareData, 'productName', ''),\n    get(extractAndPrepareData, 'product_details.api_name', ''),\n    get(extractAndPrepareData, 'product_details.generic_name', ''),\n    get(extractAndPrepareData, 'productDetails.apiName', ''),\n    get(extractAndPrepareData, 'api_name', ''),\n    get(extractAndPrepareData, 'generic_name', ''),\n    // Fall back to whatever Parse AI Response already carries, in case\n    // \"Extract and Prepare\" is unreachable or didn't capture a product name.\n    get(data, 'product_details.api_name', ''),\n    get(data, 'product_details.generic_name', ''),\n    // Last resort: mine the product name out of the checks themselves (see FIX above).\n    findProductNameFromChecks(data),\n  ];\n  return candidates.find((c) => c) || '';\n}\nfunction resolvePrimaryDocumentName() {\n  // Reuse the same candidate-filename collection used for product code \u2014 it\n  // already prioritizes \"Extract and Prepare\"'s own binary filename (the raw\n  // upload's own name, and only the PRIMARY/test document's, never a\n  // reference document's) over anything carried in JSON.\n  const filenames = collectCandidateFilenames();\n  for (const fn of filenames) {\n    const label = extractDocumentLabel(fn);\n    if (label) return label;\n  }\n  // Fall back to whatever Parse AI Response captured as the main file name.\n  const mainFileName = get(data, 'main_file_name', '');\n  if (mainFileName) return mainFileName;\n  // FIX: some passes (e.g. excipient/raw-material COA checks) never populate\n  // documents_analyzed, main_file_name, or any binary/filename a label can be\n  // parsed from \u2014 but they do carry a document_type/product_type code (e.g.\n  // \"COA_PM\") identifying what kind of report this is, the same role\n  // main_file_name/documents_analyzed play for every other pass. Use that,\n  // prettified, before giving up and falling back to report_title wholesale.\n  const typeCode = get(data, 'document_type', '') || get(data, 'product_type', '');\n  return typeCode ? String(typeCode).replace(/_/g, ' ') : '';\n}\nconst productNameForTitle = resolveProductName();\nconst primaryDocumentNameForTitle = resolvePrimaryDocumentName();\nconst reportTitle =\n  [productNameForTitle, primaryDocumentNameForTitle].filter(Boolean).join(' \u2014 ') ||\n  get(data, 'report_title', 'GPMI Pharmaceutical Dossier Compliance Report');\n\n// ---------------------------------------------------------------------------\n// DYNAMIC IMAGE DISCOVERY\n// ---------------------------------------------------------------------------\n// Heuristic key-name hint used only to produce a nicer default label when no\n// caption/title/name/filename is available alongside the image.\nconst IMAGE_KEY_HINT = /(image|structure|figure|photo|diagram|chem(ical)?_?structure|molecule|graphic|picture|img)/i;\n\n// Sniff a raw (un-prefixed) base64 string's image type from its magic bytes.\nfunction guessMimeFromBase64(str) {\n  if (typeof str !== 'string') return null;\n  if (str.startsWith('/9j/')) return 'image/jpeg';\n  if (str.startsWith('iVBORw0KG')) return 'image/png';\n  if (str.startsWith('R0lGOD')) return 'image/gif';\n  if (str.startsWith('UklGR')) return 'image/webp';\n  if (str.startsWith('PHN2Zy')) return 'image/svg+xml';\n  if (str.startsWith('Qk0')) return 'image/bmp';\n  return null;\n}\nfunction isLikelyBase64Image(str) {\n  if (typeof str !== 'string' || str.length < 80) return false;\n  return !!guessMimeFromBase64(str);\n}\nfunction isImageUrl(str) {\n  return typeof str === 'string' && /^https?:\\/\\/\\S+\\.(png|jpe?g|gif|svg|webp|bmp)(\\?\\S*)?$/i.test(str.trim());\n}\n// Normalize any of the supported shapes (data URI, raw base64 string, image\n// URL, or an n8n/binary-like object) into a usable <img src=\"...\">.\nfunction toImageSrc(value) {\n  if (!value) return null;\n  if (typeof value === 'string') {\n    const v = value.trim();\n    if (/^data:image\\//i.test(v)) return v;\n    if (isImageUrl(v)) return v;\n    if (isLikelyBase64Image(v)) return `data:${guessMimeFromBase64(v)};base64,${v}`;\n    return null;\n  }\n  if (typeof value === 'object' && !Array.isArray(value)) {\n    const b64 = value.data || value.base64 || value.base64Data || value.content;\n    if (typeof b64 === 'string' && b64.length > 0) {\n      if (/^data:image\\//i.test(b64)) return b64;\n      const mime = value.mimeType || value.mime_type || value.contentType || guessMimeFromBase64(b64);\n      if (mime && String(mime).startsWith('image/')) return `data:${mime};base64,${b64}`;\n      if (!value.mimeType && !value.mime_type && !value.contentType && guessMimeFromBase64(b64)) {\n        return `data:${guessMimeFromBase64(b64)};base64,${b64}`;\n      }\n    }\n    if (typeof value.url === 'string' && isImageUrl(value.url)) return value.url;\n  }\n  return null;\n}\n// Recursively walk any node of the payload and collect every image-like value\n// found, tagged with the dotted/bracketed path it was found at so callers can\n// decide where in the report it belongs (e.g. path starting with\n// \"entry_checks[2]\" belongs on that entry's card).\nfunction collectImages(node, path, depth, results, visited) {\n  if (node === null || node === undefined || depth > 10) return results;\n  if (typeof node === 'object') {\n    if (visited.has(node)) return results;\n    visited.add(node);\n  }\n  if (Array.isArray(node)) {\n    node.forEach((item, i) => collectImages(item, `${path}[${i}]`, depth + 1, results, visited));\n    return results;\n  }\n  if (typeof node !== 'object') return results;\n  // The node itself may BE an image-bearing object, e.g. { data, mimeType, fileName }.\n  const directSrc = toImageSrc(node);\n  if (directSrc) {\n    results.push({\n      path,\n      label: node.caption || node.label || node.title || node.name || node.fileName || node.filename || (path.split(/[.\\[]/).pop() || 'Image').replace(/_/g, ' '),\n      src: directSrc,\n    });\n  }\n  for (const key of Object.keys(node)) {\n    const val = node[key];\n    const childPath = `${path}.${key}`;\n    if (typeof val === 'string') {\n      const src = toImageSrc(val);\n      if (src) {\n        const captionKey = ['caption', 'label', 'title', 'name', 'description'].find((k) => typeof node[k] === 'string' && node[k]);\n        results.push({\n          path: childPath,\n          label: (captionKey && node[captionKey]) || (IMAGE_KEY_HINT.test(key) ? key.replace(/_/g, ' ') : key.replace(/_/g, ' ')),\n          src,\n        });\n        continue;\n      }\n    }\n    if (val && typeof val === 'object') {\n      collectImages(val, childPath, depth + 1, results, visited);\n    }\n  }\n  return results;\n}\n// Binary attachments on the incoming item itself (n8n's own binary channel,\n// separate from `json`) \u2014 e.g. an extracted chemical-structure image that a\n// prior node attached as binary data rather than embedding it in JSON.\nfunction collectBinaryImages(inputItem) {\n  const out = [];\n  const binary = inputItem && inputItem.binary;\n  if (!binary || typeof binary !== 'object') return out;\n  for (const key of Object.keys(binary)) {\n    const b = binary[key