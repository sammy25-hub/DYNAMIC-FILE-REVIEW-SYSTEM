    {
      "parameters": {
        "jsCode": "const zlib = require(\"zlib\");\n\n // \u2500\u2500 ROLE AUTO-DETECTION FROM FILENAME \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nconst ROLE_MAP = [\n  { pattern: /method\\s+of\\s+analysis\\s+of\\s+finished/i, role: \"METHOD_ANALYSIS_FP\" },\n  { pattern: /analytical\\s+method\\s+validation.*assay/i, role: \"AMV_ASSAY\" },\n  { pattern: /analytical\\s+method.*validation.*report.*micro|validation\\s+report.*micro/i, role: \"AMV_REPORT_MICRO\" },\n  { pattern: /analytical\\s+method.*validation.*protocol.*micro|validation\\s+protocol.*micro/i, role: \"AMV_PROTOCOL_MICRO\" },\n  { pattern: /analytical\\s+method.*validation.*microbiology/i, role: \"AMV_MICRO\" },\n  { pattern: /analytical\\s+method\\s+validation.*protocol.*sterility|sterility\\s+method\\s+validation/i, role: \"AMV_PROTOCOL_STERILITY\" },\n  { pattern: /analytical\\s+method\\s+validation.*report.*sterility/i, role: \"AMV_REPORT_STERILITY\" },\n  { pattern: /analytical\\s+method.*validation.*protocol.*\\bbet\\b/i, role: \"AMV_PROTOCOL_BET\" },\n  { pattern: /analytical\\s+method.*validation.*report.*\\bbet\\b/i, role: \"AMV_REPORT_BET\" },\n  { pattern: /analytical\\s+method.*validation.*(?:report|protocol).*dissolution|validation\\s+(?:report|protocol).*dissolution/i, role: \"AMV_REPORT_DISSOLUTION\" },\n  { pattern: /analytical\\s+method.*validation.*report.*related\\s+substance/i, role: \"AMV_REPORT_RELATED_SUBSTANCE\" },\n  { pattern: /analytical\\s+method.*validation.*protocol.*related\\s+substance/i, role: \"AMV_PROTOCOL_RELATED_SUBSTANCE\" },\n  { pattern: /finish\\s+product\\s+release/i, role: \"FP_RELEASE\" },\n  { pattern: /qualitative.*quantitative/i, role: \"QQ\" },\n  { pattern: /specifications?\\s+of\\s+finished/i, role: \"SPEC_FP\" },\n  { pattern: /\\bstability\\s+protocols?\\s+and\\s+reports?\\s+for\\s+(?:finished\\s+products?|fp)\\b/i, role: \"STABILITY_FP\" },\n  { pattern: /\\bstability\\s+protocols?\\s+and\\s+reports?\\s+for\\s+(?:api|active\\s+pharmaceutical\\s+ingredient)\\b/i, role: \"STABILITY_API\" },\n  { pattern: /coa\\s+(for|of)\\s+finished/i, role: \"COA_FINISHED\" },\n  { pattern: /specification\\s+of\\s+excipients/i, role: \"EXCIPIENT_SPEC\" },\n  { pattern: /coa\\s+of\\s+excipients/i, role: \"COA_EXCIPIENTS\" },\n  { pattern: /manufacturing\\s+process/i, role: \"FPMP\" },\n  { pattern: /coa\\s+for\\s+api/i, role: \"COA_API\" },\n  { pattern: /specifications?\\s+of\\s+api/i, role: \"API_SPEC\" },\n  { pattern: /method\\s+of\\s+analysis\\s+of\\s+api/i, role: \"METHOD_ANALYSIS_API\" },\n  { pattern: /product\\s+development\\s+report/i, role: \"PDR\" },\n  { pattern: /in[\\s-]*process[\\s-]*(?:control|spec)/i, role: \"FP_INPROCESS\" },\n  { pattern: /smpc/i, role: \"SMPC\" },\n  { pattern: /patient\\s+information|pil/i, role: \"PIL\" },\n  { pattern: /packing\\s+material\\s+spec/i, role: \"PACKING_SPEC\" },\n  { pattern: /storage\\s+condition/i, role: \"STORAGE\" },\n  { pattern: /analytical\\s+method\\s+validation\\s+of\\s+api/i, role: \"AMV_API\" },\n  { pattern: /literature\\s+review/i, role: \"LITERATURE_REVIEW\" },\n  { pattern: /compendium\\s+monograph\\s*[-\\u2013]?\\s*api/i, role: \"MONOGRAPH_API\" },\n  { pattern: /compendium\\s+monograph\\s*[-\\u2013]?\\s*(?:fp|finished)/i, role: \"MONOGRAPH_FP\" },\n  { pattern: /chemical\\s+properties/i, role: \"CHEM_PROPERTIES\" },\n  { pattern: /physi[oc]*chemical\\s+characteristics?\\s+of\\s+excipients/i, role: \"PHYS_CHEM_EXC\" },\n  { pattern: /physical.*chemical/i, role: \"PHYS_CHEM\" },\n  { pattern: /organoleptic/i, role: \"ORGANOLEPTIC\" },\n  { pattern: /product\\s+release/i, role: \"PRODUCT_RELEASE\" },\n  { pattern: /working\\s+standard\\s+msds/i, role: \"WS_MSDS\" },\n  { pattern: /finished\\s+product\\s+msds/i, role: \"MSDS_FP\" },\n  { pattern: /msds/i, role: \"MSDS\" },\n  { pattern: /api\\s+summary/i, role: \"API_SUMMARY\" },\n  { pattern: /inn.*atq/i, role: \"INN_ATQ\" },\n  { pattern: /coa\\s+for\\s+packing/i, role: \"COA_PACKING\" },\n];\n\nfunction detectRole(filename) {\n  for (const entry of ROLE_MAP) {\n    if (entry.pattern.test(filename)) return entry.role;\n  }\n  return \"REFERENCE\";\n}\n\n// \u2500\u2500 DOCX / ZIP HELPERS \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nfunction findEOCD(buf) {\n  for (let i = buf.length - 22; i >= 0; i--) {\n    if (buf.readUInt32LE(i) === 0x06054b50) return i;\n  }\n  return -1;\n}\nfunction parseZip(buf) {\n  const eocd = findEOCD(buf);\n  if (eocd === -1) return null;\n  const cdOff = buf.readUInt32LE(eocd + 16);\n  const cnt = buf.readUInt16LE(eocd + 10);\n  const entries = [];\n  let p = cdOff;\n  for (let i = 0; i < cnt; i++) {\n    const cm = buf.readUInt16LE(p + 10);\n    const cs = buf.readUInt32LE(p + 20);\n    const nl = buf.readUInt16LE(p + 28);\n    const el = buf.readUInt16LE(p + 30);\n    const cl = buf.readUInt16LE(p + 32);\n    const lo = buf.readUInt32LE(p + 42);\n    const nm = buf.slice(p + 46, p + 46 + nl).toString(\"utf-8\");\n    entries.push({ name: nm, compMethod: cm, compSize: cs, localOffset: lo });\n    p += 46 + nl + el + cl;\n  }\n  return { entries };\n}\nfunction extractEntry(buf, e) {\n  const p = e.localOffset;\n  const nl = buf.readUInt16LE(p + 26);\n  const el = buf.readUInt16LE(p + 28);\n  const d = buf.slice(p + 30 + nl + el, p + 30 + nl + el + e.compSize);\n  return e.compMethod === 8 ? zlib.inflateRawSync(d) : d;\n}\nfunction decodeXml(s) {\n  return s\n    .replace(/&amp;/g, \"&\")\n    .replace(/&lt;/g, \"<\")\n    .replace(/&gt;/g, \">\")\n    .replace(/&quot;/g, '\"')\n    .replace(/&apos;/g, \"'\");\n}\n\n// \u2500\u2500 PER-DOCUMENT IMAGE STATE \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// _imgCounter is global (unique imgId across all docs in one run).\n// _imgAccum is reset per-DOCX (image buffers collected across all parts).\nlet _imgCounter = 0;\nlet _imgAccum = []; // { imgId, docId, paragraphIdx, path, mimeType, buf }\n\n// Parse a _rels/*.rels XML blob \u2192 rId map (image entries only).\n// Skips EMF/WMF \u2014 vector formats GPT-4 vision cannot interpret.\n// NOTE: this is called once PER OWNING PART (document.xml, header1.xml, ...)\n// because each part in a DOCX has its OWN independent rId namespace \u2014 the\n// same rId string (e.g. \"rId2\") can point to a completely different target\n// in header1.xml.rels than it does in document.xml.rels. Loading only\n// document.xml.rels and using it for every part (the old behavior) silently\n// failed to resolve any image blips living inside headers/footers.\nfunction parseRels(relsXml) {\n  const map = {};\n  // Match both attribute orderings: Id before Type, or Type before Id\n  const re = /<Relationship\\b[^>]*>/g;\n  let m;\n  while ((m = re.exec(relsXml)) !== null) {\n    const tag = m[0];\n    if (!/\\/image\"/i.test(tag)) continue; // only image relationships\n    const idM  = tag.match(/\\bId=\"([^\"]+)\"/);\n    const tgtM = tag.match(/\\bTarget=\"([^\"]+)\"/);\n    if (!idM || !tgtM) continue;\n    const rId = idM[1];\n    const target = tgtM[1]; // e.g. \"media/image1.png\"\n    const fullPath = 'word/' + target.replace(/^\\//, '');\n    const ext = target.split('.').pop().toLowerCase();\n    const mimeMap = { png:'image/png', jpg:'image/jpeg', jpeg:'image/jpeg', gif:'image/gif', tiff:'image/tiff', bmp:'image/bmp' };\n    const mimeType = mimeMap[ext];\n    if (mimeType) map[rId] = { path: fullPath, mimeType };\n  }\n  return map;\n}\n\n\n// \u2500\u2500 OMML MATH PRE-PROCESSOR \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// Word Equation Editor stores fractions as OMML: <m:f><m:num>\u2026</m:num><m:den>\u2026</m:den></m:f>\n// These contain NO <w:t> elements, so they are silently dropped by extractTexts().\n// This function converts them to plain w:r/w:t runs BEFORE XML parsing:\n//   <m:f>  \u2192 (numerator)/(denominator)  e.g. \"(A-B)/(C)\"\n//   <m:r>  \u2192 plain text run             e.g. \"\u00d7\", \"100\"\n// Called once per XML entry, output fed into extractTexts() and extractTables().\nfunction extractMathText(xml) {\n  return [...xml.matchAll(/<m:t[^>]*>([^<]*)<\\/m:t>/g)]\n    .map((x) => x[1])\n    .join(\"\");\n}\nfunction normalizeMath(xml) {\n  // Step 1: convert <m:f> fraction blocks \u2192 (num)/(den)\n  xml = xml.replace(/<m:f\\b[\\s\\S]*?<\\/m:f>/g, (frac) => {\n    const numM = frac.match(/<m:num\\b[\\s\\S]*?<\\/m:num>/);\n    const denM = frac.match(/<m:den\\b[\\s\\S]*?<\\/m:den>/);\n    const num = numM ? extractMathText(numM[0]) : \"\";\n    const den = denM ? extractMathText(denM[0]) : \"\";\n    if (!num && !den) return \"\";\n    const text = den ? `(${num})/(${den})` : num;\n    return `<w:r><w:t xml:space=\"preserve\"> ${text} </w:t></w:r>`;\n  });\n  // Step 2: convert remaining math runs <m:r>\u2026<m:t>text</m:t>\u2026</m:r> \u2192 w:r runs\n  xml = xml.replace(/<m:r\\b[\\s\\S]*?<\\/m:r>/g, (mr) => {\n    const text = [...mr.matchAll(/<m:t[^>]*>([^<]*)<\\/m:t>/g)]\n      .map((x) => x[1])\n      .join(\"\");\n    return text ? `<w:r><w:t xml:space=\"preserve\">${text}</w:t></w:r>` : \"\";\n  });\n  return xml;\n}\n\nfunction extractTexts(xml) {\n  const texts = [];\n  const re = /<w:p[ >][\\s\\S]*?<\\/w:p>/g;\n  let m;\n  while ((m = re.exec(xml)) !== null) {\n    const para = m[0];\n    // Parse each run <w:r>...</w:r> to detect superscript/subscript\n    const runs = [...para.matchAll(/<w:r[ >][\\s\\S]*?<\\/w:r>/g)];\n    let paraText = \"\";\n    for (const run of runs) {\n      const runXml = run[0];\n      // Mark struck-through text with [STRUCK: ...] so AI has full context\n      // Matches: <w:strike/>, <w:strike w:val=\"true\"/>, <w:dstrike/>, non-self-closing variants\n      // EXCLUDES: <w:strike w:val=\"false\"/> and <w:strike w:val=\"0\"/> \u2014 these are \"strike OFF\"\n      const strikeTagMatch = runXml.match(\n        /<w:(?:d)?strike(?:\\s[^>]*)?(?:\\/>|>[\\s\\S]*?<\\/w:(?:d)?strike>)/,\n      );\n      const hasStrike =\n        strikeTagMatch !== null &&\n        !/w:val=\"(?:false|0)\"/.test(strikeTagMatch[0]);\n      const vertMatch = runXml.match(\n        /<w:vertAlign\\s+w:val=\"(superscript|subscript)\"/,\n      );\n      const tMatches = [...runXml.matchAll(/<w:t[^>]*>([^<]*)<\\/w:t>/g)];\n      let runText = decodeXml(tMatches.map((x) => x[1]).join(\"\"));\n      if (vertMatch && runText) {\n        if (vertMatch[1] === \"superscript\") runText = `<sup>${runText}</sup>`;\n        else runText = `<sub>${runText}</sub>`;\n      }\n      if (hasStrike && runText) runText = `[STRUCK: ${runText}]`;\n      paraText += runText;\n    }\n    const t = paraText.trim();\n    if (t.length > 1) {\n      texts.push(t);\n    } else if (!t && /<w:drawing[\\s>]/.test(para)) {\n      // Image-only paragraph \u2014 emit a ref token resolved later with rId\n      const rm = para.match(/<a:blip\\s[^>]*r:embed=\"([^\"]+)\"/);\n      if (rm) texts.push(`[IMAGE_REF:${rm[1]}]`);\n    }\n  }\n  return texts;\n}\n\n// \u2500\u2500 TEXTBOX EXTRACTION: Extracts text from Word floating textboxes \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// Handles both modern DrawingML (wps:txbx > w:txbxContent) and legacy VML\n// (v:textbox > w:txbxContent). These are completely separate from body\n// paragraphs and tables, and contain prose that would otherwise be invisible.\n// Output: array of \"PARAGRAPH: [full text]\" strings.\nfunction extractTextboxes(xml) {\n  const results = [];\n  // Match <w:txbxContent>...</w:txbxContent> (works for both DrawingML and VML)\n  const re = /<w:txbxContent[>\\s][\\s\\S]*?<\\/w:txbxContent>/g;\n  let m;\n  while ((m = re.exec(xml)) !== null) {\n    const texts = extractTexts(m[0]);\n    for (const t of texts) {\n      if (t.trim().length > 1) {\n        results.push(`PARAGRAPH: ${t.trim()}`);\n      }\n    }\n  }\n  return results;\n}\n\n// \u2500\u2500 TABLE EXTRACTION: Emits structured TABLE_ROW lines with full merge context \u2500\n// Resolves <w:gridSpan> (horizontal span) and <w:vMerge> (vertical span) so the\n// AI can reconstruct the exact visual layout of every table in the document.\n//\n// Output conventions:\n//   TABLE_ROW: col1 = col2 | col3 | ...\n//   TABLE_HEADER: text                 \u2190 single full-width cell / section title\n//   [\u00d7N] suffix                        \u2190 cell spans N columns horizontally\n//   [\u2191parentText]                      \u2190 cell is a vertical-merge continuation;\n//                                         parentText is what the merged cell said\n//   BLANK                              \u2190 cell exists but is empty\nfunction extractTables(xml) {\n  // Helper: extract all text from a single <w:tc> XML blob\n  function cellContent(tcXml) {\n    const cellParaRe = /<w:p[ >][\\s\\S]*?<\\/w:p>/g;\n    const cellParas = [];\n    let pm;\n    while ((pm = cellParaRe.exec(tcXml)) !== null) {\n      const cellRunRe = /<w:r[ >][\\s\\S]*?<\\/w:r>/g;\n      let paraText = \"\";\n      let runMatch;\n      while ((runMatch = cellRunRe.exec(pm[0])) !== null) {\n        const runXml = runMatch[0];\n        const strikeTagMatch = runXml.match(\n          /<w:(?:d)?strike(?:\\s[^>]*)?(?:\\/>|>[\\s\\S]*?<\\/w:(?:d)?strike>)/,\n        );\n        const hasStrike =\n          strikeTagMatch !== null &&\n          !/w:val=\"(?:false|0)\"/.test(strikeTagMatch[0]);\n        const vertMatch = runXml.match(\n          /<w:vertAlign\\s+w:val=\"(superscript|subscript)\"/,\n        );\n        const tMatches = [...runXml.matchAll(/<w:t[^>]*>([^<]*)<\\/w:t>/g)];\n        let runText = decodeXml(tMatches.map((x) => x[1]).join(\"\"));\n        if (vertMatch && runText) {\n          runText =\n            vertMatch[1] === \"superscript\"\n              ? `<sup>${runText}</sup>`\n              : `<sub>${runText}</sub>`;\n        }\n        if (hasStrike && runText) runText = `[STRUCK: ${runText}]`;\n        paraText += runText;\n      }\n      paraText = paraText.trim();\n      if (paraText) {\n        cellParas.push(paraText);\n      } else if (/<w:drawing[\\s>]|<w:pict[\\s>]|<a:blip[\\s>]/.test(pm[0])) {\n        // This specific paragraph has no text but does contain an embedded\n        // image (e.g. a \"Structure:\" field where the label and the image are\n        // separate paragraphs within one larger multi-field table cell). The\n        // whole-cell fallback below only fires when the ENTIRE cell has zero\n        // text, so without this per-paragraph check, an image-only paragraph\n        // sitting alongside other text-bearing paragraphs in the same cell\n        // was being silently dropped -- never tokenized, never sent to\n        // vision analysis. Emit the same [IMAGE_REF:rId] token format the\n        // whole-cell fallback already uses, so it resolves identically\n        // downstream, but positioned correctly in this cell's paragraph order.\n        const rm = pm[0].match(/<a:blip\\s[^>]*r:embed=\"([^\"]+)\"/);\n        if (rm) cellParas.push(`[IMAGE_REF:${rm[1]}]`);\n      }\n    }\n\n    // \u2500\u2500 Nested table extraction \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n    // If this cell contains a <w:tbl> (nested table), extract its rows too.\n    // Each nested row is appended as \"col1 | col2 | ...\" so the AI sees\n    // fields like Batch No., Date of Initiation that are inside nested tables.\n    const nestedTblRe = /<w:tbl[\\s>][\\s\\S]*?<\\/w:tbl>/g;\n    let ntm;\n    while ((ntm = nestedTblRe.exec(tcXml)) !== null) {\n      const nestedTrRe = /<w:tr[\\s>][\\s\\S]*?<\\/w:tr>/g;\n      let nrm;\n      while ((nrm = nestedTrRe.exec(ntm[0])) !== null) {\n        const nestedTcRe = /<w:tc[\\s>][\\s\\S]*?<\\/w:tc>/g;\n        const nestedCells = [];\n        let ncm;\n        while ((ncm = nestedTcRe.exec(nrm[0])) !== null) {\n          // Only extract <w:p> paragraphs from nested cells (no further nesting)\n          const npRe = /<w:p[ >][\\s\\S]*?<\\/w:p>/g;\n          const nParas = [];\n          let npm;\n          while ((npm = npRe.exec(ncm[0])) !== null) {\n            const nRunRe = /<w:r[ >][\\s\\S]*?<\\/w:r>/g;\n            let nParaText = \"\";\n            let nrm2;\n            while ((nrm2 = nRunRe.exec(npm[0])) !== null) {\n              const nRunXml = nrm2[0];\n              const nStrikeMatch = nRunXml.match(\n                /<w:(?:d)?strike(?:\\s[^>]*)?(?:\\/>|>[\\s\\S]*?<\\/w:(?:d)?strike>)/,\n              );\n              const nHasStrike =\n                nStrikeMatch !== null &&\n                !/w:val=\"(?:false|0)\"/.test(nStrikeMatch[0]);\n              const nTMatches = [\n                ...nRunXml.matchAll(/<w:t[^>]*>([^<]*)<\\/w:t>/g),\n              ];\n              let nRunText = decodeXml(nTMatches.map((x) => x[1]).join(\"\"));\n              if (nHasStrike && nRunText) nRunText = `[STRUCK: ${nRunText}]`;\n              nParaText += nRunText;\n            }\n            nParaText = nParaText.trim();\n            if (nParaText) nParas.push(nParaText);\n          }\n          const cellText = nParas.join(\" \").trim();\n          if (cellText) nestedCells.push(cellText);\n        }\n        if (nestedCells.length > 0) {\n          cellParas.push(nestedCells.join(\" | \"));\n        }\n      }\n    }\n    // \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n    const joined = cellParas.join(\" | \");\n    if (!joined && /<w:drawing[\\s>]|<w:pict[\\s>]|<a:blip[\\s>]/.test(tcXml)) {\n      const rm = tcXml.match(/<a:blip\\s[^>]*r:embed=\"([^\"]+)\"/);\n      return rm ? `[IMAGE_REF:${rm[1]}]` : '[IMAGE]';\n    }\n    return joined;\n  }\n\n  // Helper: check if a cell uses Word's automatic paragraph numbering (w:numPr)\n  // These cells are visually numbered by Word but contain no <w:t> text.\n  function cellHasNumPr(tcXml) {\n    return (\n      /<w:numPr>/.test(tcXml) && /<w:numId\\s+w:val=\"(?!0\")[^\"]*\"/.test(tcXml)\n    );\n  }\n\n  const rows = [];\n\n  // \u2500\u2500 Balanced-tag range finder \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n  // Returns [[start, end], ...] for every top-level instance of the tag.\n  // Works correctly when the same tag is nested (e.g. <w:tbl> inside <w:tc>\n  // inside another <w:tbl>): inner instances are counted but not recorded,\n  // so only the outermost balanced pairs are returned.\n  function findRanges(str, openRe, closeStr) {\n    const ranges = [];\n    // Escape < > / so closeStr can be used as a regex literal\n    const ec = closeStr.replace(/[<>/]/g, \"\\\\$&\");\n    const re = new RegExp(`(${openRe.source})|${ec}`, \"g\");\n    let depth = 0,\n      start = -1,\n      m;\n    while ((m = re.exec(str)) !== null) {\n      if (m[1] !== undefined) {\n        // opening tag\n        if (depth === 0) start = m.index;\n        depth++;\n      } else {\n        // closing tag\n        if (depth > 0) depth--;\n        if (depth === 0 && start !== -1) {\n          ranges.push([start, m.index + m[0].length]);\n          start = -1;\n        }\n      }\n    }\n    return ranges;\n  }\n\n  // Find all top-level <w:tbl> elements (nested tables are skipped at this level)\n  for (const [tblS, tblE] of findRanges(xml, /<w:tbl[\\s>]/, \"</w:tbl>\")) {\n    const tblXml = xml.slice(tblS, tblE);\n    const vmergeState = {};\n    let col0IsSerialNo = false;\n    let serialCounter = 0;\n\n    // Find direct-child <w:tr> rows (rows inside nested <w:tbl> inside a <w:tc> are skipped)\n    for (const [trS, trE] of findRanges(tblXml, /<w:tr[\\s>]/, \"</w:tr>\")) {\n      const rm0 = tblXml.slice(trS, trE);\n      let gridCol = 0;\n      const displayCells = [];\n      const rawCells = [];\n\n      // Find direct-child <w:tc> cells (cells inside nested table rows are skipped)\n      for (const [tcS, tcE] of findRanges(rm0, /<w:tc[\\s>]/, \"</w:tc>\")) {\n        const cm0 = rm0.slice(tcS, tcE);\n\n        const gsMatch = cm0.match(/<w:gridSpan\\s+w:val=\"(\\d+)\"/);\n        const colSpan = gsMatch ? parseInt(gsMatch[1], 10) : 1;\n        const vmRestart = /<w:vMerge\\s+w:val=\"restart\"\\s*\\/>/.test(cm0);\n        const vmCont =\n          !vmRestart && /<w:vMerge(?:\\s+w:val=\"[^\"]*\")?\\s*\\/>/.test(cm0);\n        const text = cellContent(cm0);\n        const hasNum = cellHasNumPr(cm0);\n\n        rawCells.push({\n          tcXml: cm0,\n          gridCol,\n          colSpan,\n          vmRestart,\n          vmCont,\n          text,\n          hasNum,\n        });\n\n        if (vmCont) {\n          for (let c = 0; c < colSpan; c++) {\n            const parent = vmergeState[gridCol + c] || \"merged\";\n            displayCells.push(`[\u2191${parent}]`);\n          }\n        } else {\n          const spanTag = colSpan > 1 ? `[\u00d7${colSpan}]` : \"\";\n          const cellStr = (text || \"BLANK\") + spanTag;\n          displayCells.push(cellStr);\n          for (let c = 0; c < colSpan; c++) {\n            if (vmRestart) {\n              vmergeState[gridCol + c] = text || \"BLANK\";\n            } else {\n              delete vmergeState[gridCol + c];\n            }\n          }\n        }\n\n        gridCol += colSpan;\n      }\n\n      // \u2500\u2500 S.No. auto-numbering recovery \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n      if (displayCells.length >= 2) {\n        const firstCellText = displayCells[0];\n        if (\n          /^S\\.?\\s*N[oO]\\.?$|^Sr\\.?\\s*N[oO]\\.?$/i.test(\n            firstCellText.replace(/\\[.*?\\]/g, \"\").trim(),\n          )\n        ) {\n          col0IsSerialNo = true;\n          serialCounter = 0;\n        } else if (col0IsSerialNo && firstCellText === \"BLANK\") {\n          const col0Cell = rawCells.find((c) => c.gridCol === 0 && !c.vmCont);\n          if (col0Cell && col0Cell.hasNum) {\n            serialCounter++;\n            displayCells[0] = `${serialCounter}.`;\n          }\n        } else if (\n          col0IsSerialNo &&\n          firstCellText !== \"BLANK\" &&\n          !/^\\[/.test(firstCellText)\n        ) {\n          col0IsSerialNo = false;\n        }\n      }\n      // \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n      if (displayCells.length === 0) continue;\n      if (displayCells.length === 1) {\n        const cellTxt = displayCells[0];\n        // Long single-cell rows are prose/narrative, not table headers\n        const isProse =\n          cellTxt.length > 60 &&\n          /\\s{2,}|[.!?]\\s|\\w{4,}\\s+\\w{4,}\\s+\\w{4,}/.test(cellTxt);\n        rows.push(\n          isProse ? `PARAGRAPH: ${cellTxt}` : `TABLE_HEADER: ${cellTxt}`,\n        );\n      } else if (displayCells.length === 2) {\n        rows.push(`TABLE_ROW: ${displayCells[0]} = ${displayCells[1]}`);\n      } else {\n        rows.push(\n          `TABLE_ROW: ${displayCells[0]} = ${displayCells.slice(1).join(\" | \")}`,\n        );\n      }\n    }\n  }\n  return rows;\n}\n\n// \u2500\u2500 PDF EXTRACTION VIA RENDER API \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nconst PDF_API_URL = \"https://artworkrendercode.onrender.com/extract-gpmi\";\n\nasync function extractPdfViaApi(buf, fileName, helpers) {\n  // Manual multipart/form-data \u2014 no external deps needed\n  const boundary = \"----n8nBoundary\" + Date.now().toString(36);\n  const header = Buffer.from(\n    `--${boundary}\\r\\n` +\n      `Content-Disposition: form-data; name=\"file\"; filename=\"${fileName}\"\\r\\n` +\n      `Content-Type: application/pdf\\r\\n\\r\\n`,\n  );\n  const footer = Buffer.from(`\\r\\n--${boundary}--\\r\\n`);\n  const body = Buffer.concat([header, buf, footer]);\n\n  const response = await helpers.httpRequest({\n    method: \"POST\",\n    url: PDF_API_URL,\n    body,\n    headers: {\n      \"Content-Type\": `multipart/form-data; boundary=${boundary}`,\n    },\n    timeout: 120000,\n  });\n  return typeof response === \"string\" ? JSON.parse(response) : response;\n}\n\n// \u2500\u2500 FILE TYPE DETECTION \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nfunction getFileType(fileName, mimeType) {\n  const fn = (fileName || \"\").toLowerCase();\n  const mt = (mimeType || \"\").toLowerCase();\n  if (fn.endsWith(\".docx\") || mt.includes(\"wordprocessingml\")) return \"docx\";\n  if (fn.endsWith(\".pdf\") || mt.includes(\"pdf\")) return \"pdf\";\n  return \"unknown\";\n}\n\n// \u2500\u2500 MAIN: EXTRACT DOCX + PASS PDF BINARY THROUGH \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nconst item = $input.first();\nconst binary = item.binary || {};\nconst allKeys = Object.keys(binary);\n\nif (allKeys.length === 0) throw new Error(\"No files uploaded.\");\n\nconst primaryKeys = allKeys.filter((k) => k.startsWith(\"primary_document\"));\nconst refKeys = allKeys.filter((k) => k.startsWith(\"reference_documents\"));\n\nif (primaryKeys.length === 0) throw new Error(\"No primary document uploaded.\");\nif (refKeys.length === 0) throw new Error(\"No reference documents uploaded.\");\n\nconst docs = [];\nlet docId = 1;\nconst pdfItems = []; // separate output items for PDF files\n\nfor (const binKey of [...primaryKeys, ...refKeys]) {\n  const fileName = binary[binKey]?.fileName || binKey;\n  const mimeType = binary[binKey]?.mimeType || \"\";\n  const isPrimary = binKey.startsWith(\"primary_document\");\n  const fileType = getFileType(fileName, mimeType);\n\n  if (fileType === \"pdf\") {\n    // \u2500\u2500 PDF: don't load buffer, just record metadata \u2500\u2500\n    const pdfDocId = docId++;\n    docs.push({\n      docId: pdfDocId,\n      role: detectRole(fileName),\n      fileName: fileName.replace(/\\.pdf$/i, \"\"),\n      paragraphCount: 0,\n      text: \"\",\n      isPrimary,\n      fileType: \"pdf\",\n      pending: true,\n    });\n    pdfItems.push({\n      json: {\n        _type: \"pdf_extract\",\n        docId: pdfDocId,\n        binKey,\n        fileName,\n        role: detectRole(fileName),\n        isPrimary,\n        _allDocs: docs, // carry full docs array for Merge Results\n      },\n      binary: { file: binary[binKey] },\n    });\n  } else {\n    // \u2500\u2500 DOCX: extract locally \u2500\u2500\n    try {\n      const buf = await this.helpers.getBinaryDataBuffer(0, binKey);\n      const zip = parseZip(buf);\n      if (!zip) throw new Error(\"Cannot parse DOCX ZIP structure\");\n\n      // \u2500\u2500 Build a rId map PER OWNING PART (document.xml, header1.xml, ...) \u2500\u2500\n      // Each XML part in a DOCX has its own independent relationships file\n      // (word/_rels/<partname>.rels). The same rId string can point to a\n      // completely different target depending on which part it's used in \u2014\n      // e.g. \"rId2\" inside header1.xml resolves via header1.xml.rels, NOT\n      // via document.xml.rels. Loading only one global map (the old\n      // behavior) silently failed to resolve any image blips living inside\n      // headers/footers, which is exactly where approval-block signature\n      // images commonly live in these templates.\n      const partRIdMaps = {}; // 'word/document.xml' -> {rId: {path, mimeType}}, etc.\n      for (const relEntry of zip.entries) {\n        const relM = relEntry.name.match(/^word\\/_rels\\/(.+)\\.rels$/);\n        if (relM) {\n          const ownerPart = \"word/\" + relM[1]; // e.g. 'word/document.xml'\n          partRIdMaps[ownerPart] = parseRels(\n            extractEntry(buf, relEntry).toString(\"utf-8\"),\n          );\n        }\n      }\n\n      const xmlEntries = zip.entries\n        .filter((e) =>\n          /^word\\/(document|header\\d*|footer\\d*)\\.xml$/.test(e.name),\n        )\n        .sort((a, b) =>\n          a.name === \"word/document.xml\"\n            ? -1\n            : b.name === \"word/document.xml\"\n              ? 1\n              : a.name.localeCompare(b.name),\n        );\n\n      const allTexts = [];\n      const thisDocId = docId;\n\n      for (const entry of xmlEntries) {\n        const rawXml = extractEntry(buf, entry).toString(\"utf-8\");\n        const xml = normalizeMath(rawXml); // convert OMML fractions \u2192 w:t text\n        // Extract text from Word textboxes (w:txbxContent \u2014 section prose lives here)\n        const txbxTexts = extractTextboxes(xml);\n        // Extract paragraphs from non-table body content using balanced-tag\n        // ranges. The old lazy regex ([\\s\\S]*?) broke with nested tables \u2014\n        // it would mismatch open/close tags and swallow body paragraphs.\n        // findRanges() correctly tracks nesting depth.\n        const tblOpenRe = /<w:tbl[\\s>]/;\n        const tblRanges = (function () {\n          const ranges = [];\n          const ec = \"</w:tbl>\".replace(/[<>/]/g, \"\\\\$&\");\n          const re = new RegExp(`(${tblOpenRe.source})|${ec}`, \"g\");\n          let depth = 0,\n            start = -1,\n            m;\n          while ((m = re.exec(xml)) !== null) {\n            if (m[1] !== undefined) {\n              if (depth === 0) start = m.index;\n              depth++;\n            } else {\n              if (depth > 0) depth--;\n              if (depth === 0 && start !== -1) {\n                ranges.push([start, m.index + m[0].length]);\n                start = -1;\n              }\n            }\n          }\n          return ranges;\n        })();\n        // Emit tables and body paragraphs in DOCUMENT ORDER (position in XML).\n        // Previously: all tables first, then all paragraphs at the end.\n        // Now: walk each segment between tables \u2192 emit body paragraphs there,\n        //      then emit that table's rows, keeping the Word visual order intact.\n        const ordered = [];\n        let docCursor = 0;\n        for (const [s, e] of tblRanges) {\n          // Body paragraphs BEFORE this table\n          const seg = xml.slice(docCursor, s);\n          extractTexts(seg).forEach((t) => ordered.push(`PARAGRAPH: ${t}`));\n          // This table's rows (pass only the table slice so extractTables\n          // finds exactly one top-level <w:tbl> and nothing outside it)\n          extractTables(xml.slice(s, e)).forEach((r) => ordered.push(r));\n          docCursor = e;\n        }\n        // Body paragraphs after the last table (e.g. appendix prose)\n        extractTexts(xml.slice(docCursor)).forEach((t) =>\n          ordered.push(`PARAGRAPH: ${t}`),\n        );\n        // Floating textboxes have no reliable XML position \u2014 append at end\n        ordered.push(...txbxTexts);\n\n        // \u2500\u2500 Resolve THIS part's own [IMAGE_REF:rId] tokens using ITS OWN\n        // rId map, right here \u2014 before moving to the next XML part. Every\n        // ref on a line is resolved independently (global regex), so a\n        // line with multiple images (e.g. an approval-block row with 4\n        // signature cells) never has later refs blocked by an earlier\n        // unresolved one.\n        const thisPartRIdMap = partRIdMaps[entry.name] || {};\n        const baseIdx = allTexts.length;\n        const resolvedOrdered = ordered.map((raw, localIdx) => {\n          return raw.replace(/\\[IMAGE_REF:([^\\]]+)\\]/g, (full, rId) => {\n            const info = thisPartRIdMap[rId];\n            if (info) {\n              const imgId = ++_imgCounter;\n              _imgAccum.push({\n                imgId,\n                docId: thisDocId,\n                paragraphIdx: baseIdx + localIdx,\n                path: info.path,\n                mimeType: info.mimeType,\n                buf: null,\n              });\n              return `[IMAGE:imgId=${imgId}]`;\n            }\n            return full; // leave unresolved refs as literal text \u2014 never blocks sibling refs on the same line\n          });\n        });\n\n        allTexts.push(...resolvedOrdered);\n      }\n\n      // Add the final index prefix (e.g. \"[0] \", \"[1] \") now that all\n      // parts (document.xml, header*.xml, footer*.xml) have contributed\n      // and had their images resolved.\n      const resolvedLines = allTexts.map((raw, i) => `[${i}] ${raw}`);\n\n      // Extract image buffers from ZIP (for every image recorded for this doc)\n      for (const imgRef of _imgAccum.filter(r => r.docId === thisDocId && !r.buf)) {\n        const entry = zip.entries.find(e => e.name === imgRef.path);\n        if (entry) imgRef.buf = extractEntry(buf, entry);\n      }\n\n      docs.push({\n        docId: docId++,\n        role: detectRole(fileName),\n        fileName: fileName.replace(/\\.docx$/i, \"\"),\n        paragraphCount: allTexts.length,\n        text: resolvedLines.join(\"\\n\"),\n        isPrimary,\n        fileType: \"docx\",\n      });\n    } catch (err) {\n      docs.push({\n        docId: docId++,\n        role: \"ERROR\",\n        fileName,\n        paragraphCount: 0,\n        text: `ERROR: ${err.message}`,\n        error: true,\n        isPrimary,\n        fileType: \"docx\",\n      });\n    }\n  }\n}\n\n// \u2500\u2500 OUTPUT: Item 0 = DOCX results, Items 1+ = PDF files, Items N+ = DOCX images \u2500\u2500\nconst mainItem = {\n  json: {\n    _type: \"docx_results\",\n    docs,\n    docCount: docs.length,\n    pdfCount: pdfItems.length,\n    imageCount: _imgAccum.filter(r => r.buf).length,\n  },\n};\n\n// Build one n8n item per extracted image (for the Analyze Image node)\nconst imageItems = _imgAccum\n  .filter(r => r.buf)\n  .map(r => ({\n    json: {\n      _type: 'docx_image',\n      imgId: r.imgId,\n      docId: r.docId,\n      paragraphIdx: r.paragraphIdx,\n      mimeType: r.mimeType,\n      fileName: r.path.split('/').pop(),\n    },\n    binary: {\n      image: {\n        data: r.buf.toString('base64'),\n        mimeType: r.mimeType,\n        fileName: r.path.split('/').pop(),\n        fileExtension: r.path.split('.').pop(),\n      },\n    },\n  }));\n\nreturn [mainItem, ...pdfItems, ...imageItems];"
      },
