    {
      "parameters": {
        "jsCode": "// \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\n// Format Report (Universal) \u2014 n8n Code Node (Text Summary)\n// Works for ANY GPMI document type that shares the universal report\n// schema produced by the Parse-and-Normalize node (SmPC, PIL, COA,\n// MSDS, Stability, Literature Review, etc.) \u2014 nothing here is\n// hardcoded to one specific document type.\n//\n// Schema read: { _parse_status, report_header, main_file_name,\n// product_details:{api_name,generic_name,execution_date_time},\n// dosage_form, strength, is_combination, product_type,\n// documents_analyzed:[], document_id_checks:[], table_structure_checks:[],\n// entry_checks:[{checks:[...]}] (may be empty for non-entry-based doc types),\n// coverage_checks:[] (may be empty for doc types without aggregate coverage),\n// bibliography_checks:[], formatting_checks:[], arithmetic_checks:[],\n// recommended_actions:[], summary:{...}, reviewer_remarks:[] }\n//\n// The parser only computes GLOBAL totals in `summary` \u2014 per-category\n// (document identity / table / entry / bibliography / formatting)\n// breakdowns are computed locally here from the actual check arrays,\n// so this works regardless of how many checks a given document type has.\n// \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\n\nconst r = $input.item.json;\nconst s = r.summary || {};\nconst pd = r.product_details || {};\nconst docLabel = (r.main_file_name || 'DOCUMENT').toUpperCase();\n\n// \u2500\u2500 If parsing failed upstream, surface that plainly instead of a blank report \u2500\u2500\nif (r._parse_status === 'FAILED') {\n  const lines = [\n    '\u2554\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2557',\n    `  GPMI COMPLIANCE REPORT \u2014 ${docLabel}`,\n    '  \u26a0\ufe0f  PARSE FAILED \u2014 AI output was not valid JSON',\n    '\u255a\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u255d',\n    '',\n    `  Error: ${r._parse_error || 'unknown'}`,\n    '',\n    '  Raw output preview (first 500 of up to 5000 chars captured):',\n    `  ${(r._raw_ai_output || '').substring(0, 500)}...`,\n  ];\n  return [{ json: { ...r, text_summary: lines.join('\\n') } }];\n}\n\nconst icon = s.overall_status === 'COMPLIANT' ? '\u2705'\n           : s.overall_status === 'NON_COMPLIANT' ? '\u274c' : '\u26a0\ufe0f';\n\nconst docsLine = (r.documents_analyzed || [])\n  .map(d => `DOC${d.doc_id}:${d.role}`)\n  .join(', ');\n\n// \u2500\u2500 Local per-category status counter \u2014 works for any check array, any doc type \u2500\u2500\nconst OK    = st => st === 'COMPLIANT';\nconst ASM   = st => st === 'COMPLIANT_ASSUMED';\nconst NC    = st => st === 'NON_COMPLIANT';\nconst INC   = st => st === 'INCONCLUSIVE';\nconst MINOR = st => st === 'MINOR';\nconst SKIP  = st => st === 'SKIPPED' || st === 'SKIPPED_CONDITIONAL';\n\nfunction countCategory(items) {\n  const arr = items || [];\n  return {\n    ok:    arr.filter(c => OK(c.status)).length,\n    asm:   arr.filter(c => ASM(c.status)).length,\n    nc:    arr.filter(c => NC(c.status)).length,\n    inc:   arr.filter(c => INC(c.status)).length,\n    minor: arr.filter(c => MINOR(c.status)).length,\n    skip:  arr.filter(c => SKIP(c.status)).length,\n  };\n}\n\nfunction sectionLine(c) {\n  const total = (c.ok || 0) + (c.asm || 0) + (c.nc || 0) + (c.inc || 0) + (c.minor || 0) + (c.skip || 0);\n  if (total === 0) return `  [NO CHECKS]`;\n  let line = `  \u2705${c.ok || 0}  \u2139\ufe0f${c.asm || 0}  \u274c${c.nc || 0}  \u26a0\ufe0f${c.inc || 0}`;\n  if (c.minor) line += `  \ud83d\udfe1${c.minor}`;\n  if (c.skip) line += `  \u23ed\ufe0f${c.skip}`;\n  return line;\n}\n\n// \u2500\u2500 Render a generic named section only if that check array actually has entries \u2500\u2500\n// (a document type with no table_structure checks, no bibliography, etc. simply\n// omits that section rather than printing an empty/misleading one)\nfunction renderSection(title, items) {\n  if (!items || items.length === 0) return [];\n  return [`\u2500\u2500 ${title} ${'\u2500'.repeat(Math.max(0, 46 - title.length))}`, sectionLine(countCategory(items)), ''];\n}\n\nconst apiName = pd.api_name || 'N/A';\nconst genericName = pd.generic_name || '';\nconst entries = r.entry_checks || [];\nconst checksPerEntry = entries.length > 0 ? (entries[0].checks || []).length : 0;\n\nconst lines = [\n  '\u2554\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2557',\n  `  GPMI COMPLIANCE REPORT \u2014 ${docLabel}`,\n  `  Product    : ${genericName || apiName}`,\n  `  API        : ${apiName}${r.api_name_secondary ? ' + ' + r.api_name_secondary : ''}`,\n  `  Dosage Form: ${r.dosage_form || 'N/A'}  [${r.product_type || 'N/A'}]`,\n  `  Strength   : ${r.strength || 'N/A'}`,\n  `  Combination: ${r.is_combination ? 'YES' : 'NO'}`,\n  `  Docs       : ${(r.documents_analyzed || []).length} analyzed`,\n  `  Exec. Date : ${pd.execution_date_time || 'N/A'}`,\n  `  Verdict    : ${icon} ${s.overall_status || 'UNKNOWN'}`,\n  `  Submit     : ${s.ready_for_submission ? 'YES' : 'NO'}  |  Risk: ${s.regulatory_query_risk || 'N/A'}`,\n  '\u255a\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u255d',\n  '',\n  `\u2500\u2500 DOCUMENTS: ${docsLine}`,\n  '',\n  '\u2500\u2500 TOTALS \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500',\n  `  Checks: ${s.total_checks || 0}  \u2705${s.compliant || 0}  \u2139\ufe0f${s.compliant_assumed || 0}  \u274c${s.non_compliant || 0}  \u26a0\ufe0f${s.inconclusive || 0}  [skipped/conditional: ${s.skipped_conditional || 0}]`,\n];\nif (entries.length > 0) {\n  lines.push(`  Web-Verified Entries: ${s.entries_verified_by_web || 0}/${s.entries_verified_total || entries.length}`);\n}\nlines.push('');\n\n// \u2500\u2500 Document Identity / Table Structure \u2014 present for virtually every doc type \u2500\u2500\nlines.push(...renderSection('DOCUMENT IDENTIFICATION', r.document_id_checks));\nlines.push(...renderSection('TABLE STRUCTURE', r.table_structure_checks));\n\n// \u2500\u2500 Entry-Level Checks \u2014 only for document types that actually have entries (e.g. Literature Review) \u2500\u2500\nif (entries.length > 0) {\n  lines.push(`\u2500\u2500 ENTRY-LEVEL CHECKS (${entries.length} entries \u00d7 ${checksPerEntry} checks) ${'\u2500'.repeat(6)}`);\n  lines.push(sectionLine(countCategory(entries.flatMap(e => e.checks || []))));\n  lines.push('');\n\n  entries.forEach((entry, i) => {\n    const checks = entry.checks || [];\n    const statuses = checks.map(c =>\n      OK(c.status) ? '\u2705' : NC(c.status) ? '\u274c' : INC(c.status) ? '\u26a0\ufe0f' : ASM(c.status) ? '\u2139\ufe0f' : SKIP(c.status) ? '\u23ed\ufe0f' : '\u2014'\n    ).join(' ');\n    const title = (entry.title || `Entry ${entry.entry_number || i + 1}`).substring(0, 60);\n    const flaggedNC = checks.some(c => NC(c.status));\n    const alert = flaggedNC ? ' \u26d4' : '';\n    lines.push(`  #${entry.entry_number || i + 1}. ${title}${title.length >= 60 ? '\u2026' : ''}${alert}`);\n    const flagParts = [];\n    if ('is_pk_study' in entry) flagParts.push(`PK:${entry.is_pk_study ? 'Y' : 'N'}`);\n    if ('is_efficacy_study' in entry) flagParts.push(`EFF:${entry.is_efficacy_study ? 'Y' : 'N'}`);\n    if ('is_safety_study' in entry) flagParts.push(`SAF:${entry.is_safety_study ? 'Y' : 'N'}`);\n    if ('is_special_population' in entry) flagParts.push(`SPEC:${entry.is_special_population ? 'Y' : 'N'}`);\n    const flagStr = flagParts.length ? `  [${flagParts.join(' ')}]` : '';\n    lines.push(`      ${statuses}${flagStr}`);\n  });\n  lines.push('');\n}\n\n// \u2500\u2500 Aggregate Coverage Checks \u2014 only for document types that actually define them (e.g. Literature Review's PK/Efficacy/Safety/Pediatric/Combination) \u2500\u2500\nif ((r.coverage_checks || []).length > 0) {\n  lines.push('\u2500\u2500 AGGREGATE COVERAGE CHECKS \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500');\n  lines.push(sectionLine(countCategory(r.coverage_checks)));\n  const coverageFlags = [];\n  if (s.pk_coverage !== undefined) coverageFlags.push(`PK: ${s.pk_coverage ? '\u2705' : '\u274c'}`);\n  if (s.efficacy_coverage !== undefined) coverageFlags.push(`Efficacy: ${s.efficacy_coverage ? '\u2705' : '\u274c'}`);\n  if (s.safety_coverage !== undefined) coverageFlags.push(`Safety: ${s.safety_coverage ? '\u2705' : '\u274c'}`);\n  if (s.special_population_coverage !== undefined) coverageFlags.push(`Pediatric/Special Pop.: ${s.special_population_coverage ? '\u2705' : '\u26a0\ufe0f (conditional)'}`);\n  if (s.combination_coverage !== undefined) coverageFlags.push(`Combination: ${s.combination_coverage ? '\u2705' : (r.is_combination ? '\u274c' : 'N/A')}`);\n  if (coverageFlags.length) lines.push(`  ${coverageFlags.join('  |  ')}`);\n  lines.push('');\n}\n\n// \u2500\u2500 Bibliography / Formatting \u2014 only for document types that have them (e.g. Literature Review) \u2500\u2500\nlines.push(...renderSection('BIBLIOGRAPHY', r.bibliography_checks));\nlines.push(...renderSection('FORMATTING', r.formatting_checks));\n\n// \u2500\u2500 Arithmetic \u2014 only if any arithmetic checks were run \u2500\u2500\nif ((r.arithmetic_checks || []).length > 0) {\n  const arithPass = (r.arithmetic_checks || []).filter(a => a.status === 'PASS').length;\n  const arithFail = (r.arithmetic_checks || []).filter(a => a.status === 'FAIL').length;\n  lines.push('\u2500\u2500 ARITHMETIC \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500');\n  lines.push(`  Pass: ${s.arithmetic_pass || arithPass || 0}  Fail: ${s.arithmetic_fail || arithFail || 0}`);\n  lines.push('');\n}\n\n// \u2500\u2500 Cross-Document Mismatches \u2014 only if any exist \u2500\u2500\nif ((r.cross_document_mismatches || []).length > 0) {\n  lines.push('\u2500\u2500 CROSS-DOCUMENT MISMATCHES \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500');\n  (r.cross_document_mismatches || []).forEach((m, i) => {\n    lines.push(`  ${i + 1}. ${m.property}: DOC1=\"${m.document_value}\" vs ${m.ref_doc_index}=\"${m.ref_value}\" \u2014 ${m.impact}`);\n  });\n  lines.push('');\n}\n\n// \u2500\u2500 Issues / Recommended Actions \u2500\u2500\nlines.push('\u2500\u2500 ISSUES \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500');\nlines.push(`  Critical: ${s.critical_issues || 0}  Major: ${s.major_issues || 0}  Minor: ${s.minor_issues || 0}`);\nif ((r.recommended_actions || []).length > 0) {\n  lines.push('');\n  lines.push('\u2500\u2500 RECOMMENDED ACTIONS \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500');\n  (r.recommended_actions || []).forEach((a, i) => {\n    lines.push(`  ${i + 1}. [${a.priority || 'N/A'}] ${a.issue || ''} \u2014 ${a.action || 'CORRECT'}: \"${a.error_value || ''}\" \u2192 \"${a.correct_value || ''}\"`);\n  });\n}\nlines.push('');\n\n// \u2500\u2500 Reviewer Remarks \u2500\u2500\nlines.push('\u2500\u2500 REVIEWER REMARKS \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500');\n(r.reviewer_remarks || []).forEach((rm, i) => { lines.push(`  ${i + 1}. ${rm}`); });\n\nreturn [{ json: { ...r, text_summary: lines.join('\\n') } }];"
