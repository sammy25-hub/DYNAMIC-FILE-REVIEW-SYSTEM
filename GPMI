    {
      "parameters": {
        "jsCode": "// \u2500\u2500 MERGE DOCX + PDF RESULTS \u2192 BUILD userMessage \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// This node can be triggered up to 3 times:\n//   1. FALSE branch (no PDFs / before Extract PDF) \u2014 from Filter\n//   2. Extract PDF branch \u2014 carries PDF text results\n//   3. Analyze Image branch \u2014 carries image analysis results\n// We skip runs 1 (when PDFs pending) and 3 (image analysis trigger) to avoid duplicates.\n\nconst extractItems = $(\"Extract & Prepare\").all();\nconst docxItem = extractItems.find((i) => i.json._type === \"docx_results\");\nif (!docxItem) throw new Error(\"Missing DOCX results from Extract & Prepare\");\n\nconst pdfMetaItems = extractItems.filter((i) => i.json._type === \"pdf_extract\");\nconst inputItems = $input.all();\nconst triggeredByFalseBranch = inputItems.some(\n  (i) => i.json._type === \"docx_results\",\n);\n\n// If triggered by the \"Analyze Image\" Code node \u2192 skip (the main run reads it via $(\"Analyze Image\").all())\nconst triggeredByImageNode = inputItems.length > 0 && inputItems.every(\n  (i) => \"imgId\" in i.json && \"description\" in i.json,\n);\nif (triggeredByImageNode) return [];\n\n// If FALSE branch triggered us AND PDFs exist \u2192 skip this run (Extract PDF will trigger us again)\nif (triggeredByFalseBranch && pdfMetaItems.length > 0) {\n  return [];\n}\n\nconst docs = JSON.parse(JSON.stringify(docxItem.json.docs));\n\n// Try to get PDF extraction results (won't exist if no PDFs uploaded)\nlet pdfResults = [];\ntry {\n  pdfResults = $(\"Extract PDF\").all();\n} catch (e) {\n  // Extract PDF didn't run \u2014 no PDFs, that's fine\n}\n\n// Match PDF results to docs by order\nconst pdfDocs = docs.filter((d) => d.fileType === \"pdf\");\nfor (let i = 0; i < pdfDocs.length && i < pdfResults.length; i++) {\n  const api = pdfResults[i].json;\n  pdfDocs[i].paragraphCount = api.paragraphCount || 0;\n  pdfDocs[i].text = api.text || \"\";\n  if (api.fileName) pdfDocs[i].fileName = api.fileName;\n  pdfDocs[i].pending = false;\n}\n\n// \u2500\u2500 INJECT IMAGE ANALYSES \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// Pull results from the \"Analyze Image\" node (won't exist if no images).\nlet imageAnalysisItems = [];\ntry {\n  imageAnalysisItems = $(\"Analyze Image\").all();\n} catch (e) {\n  // Analyze Image node didn't run \u2014 no images in these docs, fine\n}\n\n// Build imgId \u2192 description lookup.\n// n8n's Analyze Image / OpenAI node outputs text in various fields depending on version.\nconst imgAnalysisMap = {};\nfor (const item of imageAnalysisItems) {\n  const j = item.json;\n  const imgId = j.imgId;\n  if (!imgId) continue;\n  const desc =\n    j.text ||\n    j.content ||\n    j.output ||\n    j.description ||\n    (j.message && j.message.content) ||\n    (Array.isArray(j.choices) && j.choices[0]?.message?.content) ||\n    null;\n  if (desc) imgAnalysisMap[imgId] = String(desc).trim();\n}\n\n// Replace [IMAGE:imgId=N] tokens with [IMAGE_ANALYSIS(N): \"...\"] in every doc text.\n// Capped at 800 chars per description to avoid bloating the prompt.\nif (Object.keys(imgAnalysisMap).length > 0) {\n  for (const d of docs) {\n    if (!d.text) continue;\n    d.text = d.text.replace(/\\[IMAGE:imgId=(\\d+)\\]/g, (match, id) => {\n      const desc = imgAnalysisMap[parseInt(id)];\n      return desc\n        ? `[IMAGE_ANALYSIS(${id}): \"${desc.replace(/\"/g, \"'\").substring(0, 800)}\"]`\n        : `[IMAGE:imgId=${id}:NO_ANALYSIS]`;\n    });\n  }\n}\n\n// \u2500\u2500 BUILD USER MESSAGE \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nlet userMessage = `Audit the PRIMARY DOCUMENT (DOC1) against the ${docs.length - 1} reference document(s) below.\\nCheck every section, every ingredient row, every line.\\n`;\nuserMessage += `\\nDOCUMENT ROLES DETECTED:\\n`;\nfor (const d of docs) {\n  const typeTag = d.fileType === \"pdf\" ? \" [PDF]\" : \"\";\n  userMessage += `- DOC${d.docId}: ${d.role} (${d.fileName})${d.isPrimary ? \" [PRIMARY - UNDER REVIEW]\" : \"\"}${typeTag}\\n`;\n}\nfor (const d of docs) {\n  userMessage += `\\n${\"=\".repeat(60)}\\nDOCUMENT ${d.docId} (${d.role})\\nFile: ${d.fileName}\\nType: ${d.fileType.toUpperCase()}\\nParagraphs: ${d.paragraphCount}\\n${\"=\".repeat(60)}\\n${d.text}\\n`;\n}\n\nreturn [\n  {\n    json: {\n      userMessage,\n      docCount: docs.length,\n      docRoles: docs.map((d) => ({\n        id: d.docId,\n        role: d.role,\n        file: d.fileName,\n        paragraphs: d.paragraphCount,\n        primary: d.isPrimary,\n        fileType: d.fileType,\n      })),\n    },\n  },\n];\n"
      },
