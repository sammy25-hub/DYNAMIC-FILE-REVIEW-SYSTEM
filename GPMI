    {
      "parameters": {
        "jsCode": "// \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\n// Main GPMI Review workflow \u2014 Code Node: \"Prepare Download List\"\n// ---------------------------------------------------------------\n// Position:  Webhook (GPMI-Review-Main) \u2192 [THIS NODE] \u2192 HTTP Request (download)\n//\n// Pure filtering/list-building \u2014 makes NO HTTP calls itself. Turns the one\n// item from GATE's \"Call Main Workflow\" into N items (one per file to\n// download: 1 primary + however many references), each tagged with the\n// binary key it should end up under and the passthrough fields needed\n// later in \"Merge Binaries\" and downstream (Zoho Creator callback).\n// \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\n\nconst item = $input.first().json.body;\nconst primary = item.primary_document;\nconst references = item.reference_documents || [];\nconst productCode = item.product_code || '';\n\nconst files = [\n  { ...primary, binary_key: 'primary_document' },\n  ...references.map((ref, i) => ({ ...ref, binary_key: `reference_documents_${i}` })),\n];\n\nreturn files.map((f) => ({\n  json: {\n    binary_key: f.binary_key,\n    download_url: f.download_url,\n    document_name: f.document_name,\n    gpdl_reference: f.gpdl_reference,\n    gpdl_record_id: f.gpdl_record_id,\n    product_code: productCode,\n    pipeline_key: item.pipeline_key,\n    batch_id: item.batch_id,\n    gpmi_record_id: item.gpmi_record_id,\n    primary_gpdl_record_id: primary.gpdl_record_id,\n  },\n}));\n"
