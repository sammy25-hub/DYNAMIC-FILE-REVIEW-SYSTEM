        "jsCode": "// \u2500\u2500 CHANNEL SEPARATION \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// Same contract as Split (generic): the data-table code body sees only\n// the pipeline data on $input. Config is read here and never passed in.\n\n// \u2500\u2500 DEFENSIVE DECODE \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// See Split (generic) for why: code pasted into the data table can\n// arrive HTML-entity-encoded from a rich-text paste. parserMergeCode\n// never legitimately needs literal HTML entities, so decode unconditionally.\nfunction decodeHtmlEntities(str) {\n  if (typeof str !== 'string') return str;\n  return str\n    .replace(/&lt;/g, '<')\n    .replace(/&gt;/g, '>')\n    .replace(/&quot;/g, '\"')\n    .replace(/&#0*39;|&apos;/g, \"'\")\n    .replace(/&amp;/g, '&'); // must run last\n}\n\nconst codeStr   = decodeHtmlEntities($('Get type config').first().json.parserMergeCode);\nconst dataItems = $input.all().map(it => ({ json: it.json }));\n\nif (!codeStr || codeStr.trim() === '') return dataItems;\n\nconst shim = {\n  all:   () => dataItems,\n  first: () => dataItems[0],\n  last:  () => dataItems[dataItems.length - 1],\n  item:  dataItems[0],\n};\n\ntry {\n  const fn = new Function('$input', codeStr);\n  const result = fn(shim);\n  if (Array.isArray(result)) return result;\n  if (result && typeof result === 'object' && 'json' in result) return [result];\n  return [{ json: result }];\n} catch (e) {\n  return [{ json: { _parseMergeError: e.message } }];\n}"
      },
      "id": "0dd35bb2-f07e-428f-84d1-809cc42d0b10",
